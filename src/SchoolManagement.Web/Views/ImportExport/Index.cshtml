@model ImportExportViewModel
@{
    ViewData["Title"] = "Import / Export";
    ViewData["Nav"] = "ImportExport";
    var students = Model.Kind == ImportKind.Students;
    var fields = ImportDefinitions.Fields(Model.Kind);
}

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li>Data</li><li>Import / Export</li></ol>
        <h1 class="page-title">Import / Export</h1>
        <p class="page-sub">Bring students and teachers in from Excel, or download the current lists. Nothing is saved until you check the preview and confirm.</p>
    </div>
</div>

<partial name="_Steps" model="1" />

<nav class="kind-tabs" aria-label="What to import">
    <a class="kind-tab" href="/import-export?kind=Students" aria-current="@(students ? "true" : null)">
        <span class="kind-tab__icon">@Ui.Icon("graduation-cap")</span>
        <span><span class="kind-tab__title">Students</span><br /><span class="kind-tab__meta">@Ui.Plural(Model.Students, "student", "students") now · Name and Class</span></span>
    </a>
    <a class="kind-tab" href="/import-export?kind=Teachers" aria-current="@(!students ? "true" : null)">
        <span class="kind-tab__icon">@Ui.Icon("presentation")</span>
        <span><span class="kind-tab__title">Teachers</span><br /><span class="kind-tab__meta">@Ui.Plural(Model.Teachers, "teacher", "teachers") now · Name, Job title, Contact</span></span>
    </a>
</nav>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="notice notice--error" role="alert">
        @Ui.Icon("alert-circle")
        <div class="notice__body"><strong>The file was not imported.</strong>@Model.Error</div>
    </div>
}

<div class="grid-3-1">
    <section class="card" aria-labelledby="upload-title">
        <div class="card__head">
            <div>
                <h2 class="card__title" id="upload-title">@Ui.Icon("upload")Import @(students ? "students" : "teachers")</h2>
                <p class="card__sub">Excel (.xlsx) or CSV, up to 10 MB and @Ui.Count(SchoolManagement.Web.Services.Excel.SpreadsheetReader.MaxRows) rows.</p>
            </div>
            <a class="btn btn--secondary btn--sm" href="/import-export/template/@Model.Kind">@Ui.Icon("download", "icon--sm")Download template</a>
        </div>
        <form class="card__body form-grid" method="post" action="/import-export/upload" enctype="multipart/form-data" data-loading>
            @Html.AntiForgeryToken()
            <input type="hidden" name="kind" value="@Model.Kind" />
            <label class="dropzone" data-dropzone>
                <input type="file" name="file" accept=".xlsx,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" required />
                <span class="dropzone__icon">@Ui.Icon("upload-cloud", "icon--xl")</span>
                <span class="dropzone__title">Drop your file here, or click to choose</span>
                <span class="muted">.xlsx or .csv</span>
                <span class="dropzone__file">@Ui.Icon("file-check", "icon--sm")<span data-file-name></span></span>
            </label>
            @if (students && Model.ActiveClasses == 0)
            {
                <div class="notice notice--warning">@Ui.Icon("alert-triangle")<div class="notice__body"><strong>No active classes.</strong>Every student row needs an active class. <a href="/classes">Manage classes</a>.</div></div>
            }
            <div><button class="btn btn--primary btn--lg" type="submit" data-needs-file disabled>@Ui.Icon("arrow-right")Continue to column matching</button></div>
        </form>
    </section>

    <section class="card" aria-labelledby="rules-title">
        <div class="card__head"><h2 class="card__title" id="rules-title">@Ui.Icon("info")What the file needs</h2></div>
        <div class="card__body">
            <ul class="checklist">
                @foreach (var f in fields)
                {
                    <li>@Ui.Icon("check")<span><strong>@f.Label</strong>@(f.Required ? " (required)" : " (optional)") — @f.Hint</span></li>
                }
                <li>@Ui.Icon("check")<span>Column names can differ (English or Arabic); you match them in the next step.</span></li>
                <li>@Ui.Icon("check")<span>Duplicates are skipped and invalid rows are listed with their row number — nothing is dropped silently.</span></li>
            </ul>
        </div>
    </section>
</div>

<section class="card" aria-labelledby="export-title">
    <div class="card__head">
        <div>
            <h2 class="card__title" id="export-title">@Ui.Icon("download")Export to Excel</h2>
            <p class="card__sub">To export a filtered list, filter it on the Students or Teachers page and use “Export” there.</p>
        </div>
    </div>
    <div class="quick">
        <a href="/students/export"><span class="q-icon">@Ui.Icon("graduation-cap")</span>All students (@Ui.Count(Model.Students))</a>
        <a href="/teachers/export"><span class="q-icon">@Ui.Icon("presentation")</span>All teachers (@Ui.Count(Model.Teachers))</a>
        <a href="/workload/export"><span class="q-icon">@Ui.Icon("chart")</span>Teacher workload this week</a>
        <a href="/import-export/template/@(students ? "Teachers" : "Students")"><span class="q-icon">@Ui.Icon("sheet")</span>@(students ? "Teachers" : "Students") import template</a>
    </div>
</section>
