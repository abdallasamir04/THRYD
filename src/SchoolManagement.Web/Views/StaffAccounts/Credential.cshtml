@model OneTimeCredentialModel
@*
    Shown once, to the Super Admin only, right after creating an account or resetting a password. The password is not stored
    anywhere in plain text, not logged and cannot be shown again (reset it again if it is lost).
*@
@{
    ViewData["Title"] = Model.What;
    ViewData["Nav"] = "StaffAccounts";
    ViewData["BackButtonHref"] = "/staff/accounts";
}
<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/staff/accounts">Staff accounts</a></li><li>@Model.What</li></ol>
        <h1 class="page-title">@Model.What: @Model.FullName</h1>
        <p class="page-sub">CONFIDENTIAL — SUPER ADMIN ONLY. Give these details to the person privately. They are shown only once.</p>
    </div>
</div>
<section class="card" style="max-width: 560px">
    <div class="card__body">
        <dl class="dl">
            <dt>Login e-mail</dt><dd><code>@Model.Email</code></dd>
            <dt>Password</dt><dd><code style="font-size: 1.1rem">@Model.Password</code></dd>
        </dl>
        <p class="hint">No change is forced at first sign-in: this password works until the person changes it (Account → Change password) or you reset it.</p>
        <a class="btn btn--primary" href="@(Model.StaffId is { } sid ? $"/staff/accounts/{sid}" : "/staff/accounts")">Done</a>
    </div>
</section>
