@model ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}
<section class="pp-card">
    <h1 class="pp-title">Forgot your password?</h1>
    @if (!Model.EmailConfigured)
    {
        <p class="pp-note">@Ui.Icon("info", "icon--sm")<span>Password-reset e-mails are not set up at the school yet. Please ask the Super Admin to reset your password; you will receive a new one.</span></p>
    }
    @if (Model.Sent)
    {
        <p>@(Model.EmailConfigured ? "If this e-mail belongs to an active account, a reset link has been sent. It works for one hour." : "Your request was recorded. Please contact the Super Admin.")</p>
    }
    else
    {
        <form action="/account/forgot" method="post">
            @Html.AntiForgeryToken()
            <label class="pp-label" for="Email">Your login e-mail</label>
            <input class="pp-input" id="Email" name="Email" type="email" autocomplete="username" required />
            <button class="pp-btn" type="submit">@(Model.EmailConfigured ? "Send reset link" : "Record my request")</button>
        </form>
    }
    <p class="pp-small" style="margin-top: 14px"><a href="/account/login">Back to sign in</a></p>
</section>
