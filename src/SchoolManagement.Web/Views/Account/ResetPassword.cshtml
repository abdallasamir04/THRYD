@model ResetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Choose a new password";
}
<section class="pp-card">
    <h1 class="pp-title">Choose a new password</h1>
    <div asp-validation-summary="ModelOnly" class="pp-error" role="alert"></div>
    <form action="/account/reset" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Token" value="@Model.Token" />
        <label class="pp-label" for="Email">Login e-mail</label>
        <input class="pp-input" id="Email" name="Email" type="email" value="@Model.Email" required />
        <label class="pp-label" for="NewPassword">New password</label>
        <input class="pp-input" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="12" required />
        <label class="pp-label" for="ConfirmPassword">Repeat the new password</label>
        <input class="pp-input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" required />
        <p class="pp-small">At least 12 characters with upper- and lower-case letters, a digit and a symbol.</p>
        <button class="pp-btn" type="submit">Save new password</button>
    </form>
</section>
