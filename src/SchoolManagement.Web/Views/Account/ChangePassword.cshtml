@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Nav"] = "Me";
}
<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li>Change password</li></ol>
        <h1 class="page-title">Change password</h1>
        <p class="page-sub">Optional: your current password keeps working until you change it here or the Super Admin resets it.</p>
    </div>
</div>
<div class="card form-page">
    <form action="/account/password" method="post" autocomplete="off" style="display:contents">
        @Html.AntiForgeryToken()
        <div class="modal__body form-grid">
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
            <div class="field field--full"><label class="label" for="CurrentPassword">Current password</label><input class="input" id="CurrentPassword" name="CurrentPassword" type="password" autocomplete="current-password" required /></div>
            <div class="field"><label class="label" for="NewPassword">New password</label><input class="input" id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" minlength="12" required /></div>
            <div class="field"><label class="label" for="ConfirmPassword">Repeat the new password</label><input class="input" id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="12" required /></div>
            <p class="hint field--full">At least 12 characters with upper- and lower-case letters, a digit and a symbol.</p>
        </div>
        <div class="modal__foot"><a class="btn btn--secondary" href="/me">Cancel</a><button class="btn btn--primary" type="submit">@Ui.Icon("check")Change password</button></div>
    </form>
</div>
