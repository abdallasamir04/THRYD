@model PtcBookingsViewModel
@*
    Confirmed bookings of one event (Super Admin only; never public): by class schedule and Round, with each Round's
    capacity and places left, the student, the subjects and their teachers, the booking reference and when it was made.
*@
@{
    var e = Model.Event;
    ViewData["Title"] = "Bookings · " + e.Title;
    ViewData["Nav"] = "PTC";
    ViewData["BackButtonHref"] = $"/ptc/events/{e.Id}";
    var c = System.Globalization.CultureInfo.InvariantCulture;
}
@section Head { <link rel="stylesheet" href="~/css/ptc.css" asp-append-version="true" /> }

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/ptc">PTC</a></li><li><a href="/ptc/events/@e.Id">@e.Title</a></li><li>Bookings</li></ol>
        <h1 class="page-title">Bookings <span class="badge @PtcLabels.Badge(e.Status)">@PtcLabels.Label(e.Status)</span></h1>
        <p class="page-sub">Confirmed bookings by class and Round. Each booking is one parent in one Round; their chosen teachers meet them together in the booking's slot.</p>
    </div>
</div>

<partial name="_EventNav" model='(e, "bookings")' />

<ul class="kpis" aria-label="Booking totals">
    <li><div class="kpi kpi--ok"><span class="kpi__icon">@Ui.Icon("check-circle")</span><p class="kpi__label">Confirmed bookings</p><p class="kpi__value">@Model.Total</p><p class="kpi__meta">In @Ui.Plural(Model.Schedules.Count(s => s.Bookings > 0), "class", "classes")</p></div></li>
    <li><div class="kpi kpi--teal"><span class="kpi__icon">@Ui.Icon("users")</span><p class="kpi__label">Capacity</p><p class="kpi__value">@Model.Schedules.Sum(s => s.Capacity)</p><p class="kpi__meta">Parent places in all Rounds</p></div></li>
    <li><div class="kpi kpi--orange"><span class="kpi__icon">@Ui.Icon("inbox")</span><p class="kpi__label">Places left</p><p class="kpi__value">@Model.Schedules.SelectMany(s => s.Rounds).Sum(r => r.Remaining)</p><p class="kpi__meta">@(e.BookingsOpen ? "Bookings open" : "Bookings not open")</p></div></li>
</ul>

@if (Model.Schedules.Count == 0)
{
    <section class="card"><div class="empty"><span class="empty__icon">@Ui.Icon("users")</span><p class="empty__title">No classes assigned</p><p class="empty__text">Bookings appear here once the event is published and parents book.</p></div></section>
}
@foreach (var s in Model.Schedules)
{
    <section class="card table-card ptc-day" aria-label="@s.ClassName bookings">
        <div class="card__head">
            <h2 class="card__title">@Ui.Icon("door")@s.ClassName · @s.Date.ToString("ddd d MMM yyyy", c)</h2>
            <span class="ptc-muted">@s.Bookings / @s.Capacity booked</span>
        </div>
        @foreach (var r in s.Rounds)
        {
            <h3 class="ptc-issues__area" style="padding: 0 16px">Round @r.Number · @ScheduleRules.Times(r.Start, r.End) · @r.Bookings.Count / @r.Capacity booked · @r.Remaining left
                @if (r.Bookable) { <span class="badge badge--success">Open</span> } else { <span class="badge badge--neutral">Not bookable</span> }</h3>
            @if (r.Bookings.Count == 0)
            {
                <p class="ptc-muted" style="padding: 0 16px 12px">No bookings yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table--stack">
                        <thead><tr><th scope="col">Slot</th><th scope="col">Student</th><th scope="col">Subjects &amp; teachers</th><th scope="col">Reference</th><th scope="col">Booked</th></tr></thead>
                        <tbody>
                            @foreach (var b in r.Bookings)
                            {
                                <tr>
                                    <td data-label="Slot">@b.Slot · @ScheduleRules.Times(b.Start, b.End)</td>
                                    <td data-label="Student"><strong>@b.StudentName</strong><br /><span class="ptc-muted">@s.ClassName</span></td>
                                    <td data-label="Subjects & teachers"><ul class="ptc-subjects">@foreach (var (subject, teacher) in b.Subjects) { <li>@subject <small>· @teacher</small></li> }</ul></td>
                                    <td data-label="Reference"><code>@b.Reference</code></td>
                                    <td data-label="Booked">@Ui.DateTime(b.BookedAt)<br /><span class="ptc-muted">@b.BookedBy</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
}
