@model FloorDashboardViewModel
@*
    Floor Management: each floor with a management team (grade range set) as its own full-width section, in floor order
    (Ground → 1st → 2nd), showing its organization: Stage Coordinator → Floor Supervisor → Matrons + Floating Matron, and the
    Floor Social Worker as a separate support role. Live counts of open reports and tickets. Administrators add and edit
    floors and assign the team (checked again on the server).
*@
@{
    ViewData["Title"] = "Floor Management";
    ViewData["Nav"] = "FloorAudit";
}
<span data-refresh-on-save hidden></span>

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><span aria-current="page">Floor Management</span></li></ol>
        <h1 class="page-title">Floor Management</h1>
        <p class="page-sub">Each floor's team — Stage Coordinator, Floor Supervisor, Matrons and Floating Matron — with the Floor Social Worker, reports, escalations and student tickets.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/floor-management/reports/new" data-modal>@Ui.Icon("flag")New report</a>
        <a class="btn btn--secondary" href="/floor-management/tickets/new" data-modal>@Ui.Icon("clipboard-check")Open ticket</a>
        @if (Model.User.CanAddFloor)
        {
            <a class="btn btn--primary" href="/floor-management/floors/new" data-modal>@Ui.Icon("plus")Add Floor</a>
        }
    </div>
</div>

<partial name="~/Views/FloorManagement/_Nav.cshtml" model='"floors"' />

<ul class="kpis leadership-kpis" aria-label="Floor Management totals">
    <li><div class="kpi kpi--blue"><span class="kpi__icon">@Ui.Icon("school")</span><p class="kpi__label">Floors</p><p class="kpi__value">@Model.Floors.Count</p><p class="kpi__meta">With a management team</p></div></li>
    <li><div class="kpi kpi--teal"><span class="kpi__icon">@Ui.Icon("users")</span><p class="kpi__label">Team members</p><p class="kpi__value">@Model.Floors.SelectMany(f => f.Team).Select(p => p.StaffId).Distinct().Count()</p><p class="kpi__meta">Across the floors</p></div></li>
    <li><a class="kpi @(Model.OpenReports > 0 ? "kpi--full" : "kpi--ok")" href="/floor-management/reports" style="text-decoration:none"><span class="kpi__icon">@Ui.Icon("flag")</span><p class="kpi__label">Open reports</p><p class="kpi__value">@Model.OpenReports</p><p class="kpi__meta">Not resolved or closed</p></a></li>
    <li><a class="kpi @(Model.OpenTickets > 0 ? "kpi--full" : "kpi--ok")" href="/floor-management/tickets" style="text-decoration:none"><span class="kpi__icon">@Ui.Icon("clipboard-check")</span><p class="kpi__label">Open tickets</p><p class="kpi__value">@Model.OpenTickets</p><p class="kpi__meta">Social Worker cases</p></a></li>
</ul>

@if (Model.Consultant is { } consultant)
{
    <p class="fm-chain">@Ui.Icon("crown", "icon--sm")<span>Every Stage Coordinator reports to the School Consultant, <a href="@SchoolManagement.Web.Common.OrgLabels.ProfileHref(consultant.StaffId, consultant.IsManagement)">@consultant.Name</a>, who can access all Floor Management areas.</span></p>
}

@if (Model.Floors.Count == 0)
{
    <section class="card"><div class="empty"><span class="empty__icon">@Ui.Icon("school")</span><p class="empty__title">No floors to show</p>
        <p class="empty__text">@(Model.User.CanAddFloor ? "Add a floor with its grade range and team." : "You are not assigned to a floor.")</p></div></section>
}
else
{
    <nav class="fm-jump" aria-label="Floors">
        @foreach (var f in Model.Floors)
        {
            <a href="#floor-@f.Id">@f.Name<span class="fm-jump__range">@f.GradeRange</span></a>
        }
    </nav>

    @foreach (var f in Model.Floors)
    {
        var manage = Model.User.CanManageTeam(f.Id);
        <section class="card fm-section@(f.IsActive ? "" : " is-inactive")" id="floor-@f.Id" aria-labelledby="floor-@f.Id-title">
            <header class="fm-section__head">
                <span class="fm-section__icon" aria-hidden="true">@Ui.Icon("school")</span>
                <div class="fm-section__titles">
                    <h2 class="fm-section__name" id="floor-@f.Id-title">@f.Name @if (!f.IsActive) { <span class="badge badge--neutral">Inactive</span> }</h2>
                    <p class="fm-section__meta">
                        <span class="fm-range">@Ui.Icon("graduation-cap", "icon--sm")@f.GradeRange</span>
                        <span>@Ui.Plural(f.Team.Count, "team member", "team members")</span>
                        <a href="/floor-management/reports">@Ui.Plural(f.OpenReports, "open report", "open reports")</a>
                        <a href="/floor-management/tickets">@Ui.Plural(f.OpenTickets, "open ticket", "open tickets")</a>
                    </p>
                </div>
                <div class="fm-section__actions">
                    @if (Model.User.CanAddFloor) { <a class="btn btn--secondary btn--sm" href="/floor-management/floors/@f.Id/edit" data-modal>@Ui.Icon("pencil", "icon--sm")Edit floor</a> }
                    @if (manage) { <a class="btn btn--secondary btn--sm" href="/floor-management/floors/@f.Id/assign" data-modal>@Ui.Icon("user-plus", "icon--sm")Assign staff</a> }
                    <a class="btn btn--primary btn--sm" href="/floor-management/floors/@f.Id">Floor page &amp; history @(Ui.Icon("arrow-right", "icon--sm"))</a>
                </div>
            </header>
            <partial name="~/Views/FloorManagement/_FloorHierarchy.cshtml" model="(f, manage, (SchoolManagement.Web.Services.FloorManagement.ConsultantRef?)Model.Consultant)" />
        </section>
    }
}

@if (Model.Unconfigured.Count > 0)
{
    <p class="hint" style="margin-top:16px">
        @Ui.Icon("info", "icon--sm")Floors without a management team yet (used for inspections only):
        @foreach (var f in Model.Unconfigured) { <a href="/floor-management/floors/@f.Id/edit" data-modal>@f.Name</a> }
        — set a grade range to add one to Floor Management.
    </p>
}
