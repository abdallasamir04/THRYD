@model (SchoolManagement.Web.Services.FloorManagement.FloorPerson Person, bool CanManage, int FloorId, string FloorName)
@*
    One floor team member as a card: name (opens the profile), role badge, phone number(s) as WhatsApp chat links (Ui.Phone),
    floor and grade range. Authorized administrators can edit the grade range or end the assignment (kept in the history).
*@
@using SchoolManagement.Web.Services.FloorManagement
@{
    var p = Model.Person;
    var role = FloorManagementService.Label(p.Role);
    var slug = p.Role.ToString().ToLowerInvariant();
    var phones = new[] { p.Phone, p.Phone2 }.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
}
<article class="fm-card fm-card--@slug" aria-label="@p.Name, @role">
    <header class="fm-card__head">
        <span class="avatar avatar--@Ui.Tone(p.Name)" aria-hidden="true">@Ui.Initials(p.Name)</span>
        <div class="fm-card__who">
            <a class="fm-card__name" href="@p.ProfileHref" dir="auto" title="Open the profile of @p.Name">@p.Name</a>
            <span class="fm-role fm-role--@slug">@role</span>
        </div>
    </header>
    <dl class="fm-card__facts">
        <div>
            <dt>@Ui.Icon("phone", "icon--sm")@(phones.Count > 1 ? "Phones" : "Phone")</dt>
            <dd class="fm-card__phones">
                @foreach (var phone in phones)
                {
                    @Ui.Phone(phone, "fm-phone", who: p.Name)
                }
                @if (phones.Count == 0) { <span class="faint">No phone</span> }
            </dd>
        </div>
        <div><dt>@Ui.Icon("school", "icon--sm")Floor</dt><dd>@Model.FloorName</dd></div>
        <div><dt>@Ui.Icon("graduation-cap", "icon--sm")Grade range</dt><dd class="@(p.Scope.Length == 0 ? "faint" : "")">@(p.Scope.Length == 0 ? "Not set" : p.Scope)</dd></div>
    </dl>
    @if (Model.CanManage)
    {
        <footer class="fm-card__actions">
            <a class="btn btn--secondary btn--sm" href="/floor-management/assignments/@p.AssignmentId/edit" data-modal title="Edit the grade range">@Ui.Icon("pencil", "icon--sm")Edit</a>
            <form action="/floor-management/assignments/@p.AssignmentId/end" method="post" data-ajax-form
                  data-confirm="End @p.Name's role as @role on the @Model.FloorName? It stays in the floor history." data-confirm-title="End assignment?" data-confirm-button="End">
                @Html.AntiForgeryToken()
                <input type="hidden" name="floor" value="@Model.FloorId" />
                <button class="btn btn--secondary btn--sm fm-card__end" type="submit" aria-label="End the assignment of @p.Name">@Ui.Icon("x-circle", "icon--sm")End</button>
            </form>
        </footer>
    }
</article>
