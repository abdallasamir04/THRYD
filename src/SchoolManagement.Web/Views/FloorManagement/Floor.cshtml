@model FloorDetailsViewModel
@*
    One floor: its team as a hierarchy — Stage Coordinator (senior, reports to the School Consultant) → Floor Supervisor →
    Matrons (their classes) and the Floating Matron (coverage across the floor) — and the Floor Social Worker(s).
*@
@{
    var f = Model.Floor;
    ViewData["Title"] = f.Name;
    ViewData["Nav"] = "FloorAudit";
    var manage = Model.User.CanManageTeam(f.Id);
    var sc = f.Lead(FloorRole.StageCoordinator);
    var fs = f.Lead(FloorRole.FloorSupervisor);
    var matrons = f.Of(FloorRole.Matron);
    var floating = f.Of(FloorRole.FloatingMatron);
    var social = f.Of(FloorRole.SocialWorker);
}
<span data-refresh-on-save hidden></span>

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/floor-management">Floor Management</a></li><li><span aria-current="page">@f.Name</span></li></ol>
        <h1 class="page-title">@f.Name @if (!f.IsActive) { <span class="badge badge--neutral">Inactive</span> }</h1>
        <p class="page-sub">@Ui.Icon("graduation-cap", "icon--sm")Grade range <strong>@f.GradeRange</strong> · @Ui.Plural(f.OpenReports, "open report", "open reports") · @Ui.Plural(f.OpenTickets, "open ticket", "open tickets")</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/floor-management/reports/new?floor=@f.Id" data-modal>@Ui.Icon("flag")New report</a>
        <a class="btn btn--secondary" href="/floor-management/tickets/new?floor=@f.Id" data-modal>@Ui.Icon("clipboard-check")Open ticket</a>
        @if (Model.User.CanAddFloor) { <a class="btn btn--secondary" href="/floor-management/floors/@f.Id/edit" data-modal>@Ui.Icon("pencil")Edit floor</a> }
        @if (manage) { <a class="btn btn--primary" href="/floor-management/floors/@f.Id/assign" data-modal>@Ui.Icon("user-plus")Assign staff</a> }
    </div>
</div>

<partial name="~/Views/FloorManagement/_Nav.cshtml" model='"floors"' />

<section class="fm-tree" aria-label="@f.Name team">
    <div class="fm-level fm-level--lead">
        <p class="fm-level__label">@Ui.Icon("crown", "icon--sm")Stage Coordinator — senior coordinator of the floor@(Model.Consultant is { } c ? $" · reports to the School Consultant, {c.Name}" : "")</p>
        @if (sc is not null) { <partial name="~/Views/FloorManagement/_Person.cshtml" model="(sc, manage, f.Id)" /> }
        else { <div class="fm-empty">No Stage Coordinator assigned. @if (manage) { <a href="/floor-management/floors/@f.Id/assign?role=StageCoordinator" data-modal>Assign one</a> }</div> }
    </div>
    <div class="fm-arrow" aria-hidden="true">@Ui.Icon("arrow-down")</div>
    <div class="fm-level">
        <p class="fm-level__label">@Ui.Icon("shield-check", "icon--sm")Floor Supervisor — daily operations; reports to the Stage Coordinator</p>
        @if (fs is not null) { <partial name="~/Views/FloorManagement/_Person.cshtml" model="(fs, manage, f.Id)" /> }
        else { <div class="fm-empty">No Floor Supervisor assigned. @if (manage) { <a href="/floor-management/floors/@f.Id/assign?role=FloorSupervisor" data-modal>Assign one</a> }</div> }
    </div>
    <div class="fm-arrow" aria-hidden="true">@Ui.Icon("arrow-down")</div>
    <div class="fm-level fm-level--split">
        <div>
            <p class="fm-level__label">@Ui.Icon("users", "icon--sm")Matrons — assigned classes; report to the Floor Supervisor</p>
            @foreach (var m in matrons) { <partial name="~/Views/FloorManagement/_Person.cshtml" model="(m, manage, f.Id)" /> }
            @if (matrons.Count == 0) { <div class="fm-empty">No Matrons assigned.</div> }
            @if (manage) { <a class="fm-add" href="/floor-management/floors/@f.Id/assign?role=Matron" data-modal>@Ui.Icon("plus", "icon--sm")Add Matron</a> }
        </div>
        <div>
            <p class="fm-level__label">@Ui.Icon("swap", "icon--sm")Floating Matron — coverage across the floor; reports to the Floor Supervisor, escalates to the Stage Coordinator</p>
            @foreach (var m in floating) { <partial name="~/Views/FloorManagement/_Person.cshtml" model="(m, manage, f.Id)" /> }
            @if (floating.Count == 0) { <div class="fm-empty">No Floating Matron assigned.</div> }
            @if (manage) { <a class="fm-add" href="/floor-management/floors/@f.Id/assign?role=FloatingMatron" data-modal>@Ui.Icon("plus", "icon--sm")Add Floating Matron</a> }
        </div>
    </div>
</section>

<section class="card" aria-labelledby="sw-title" style="margin-top:20px">
    <div class="card__head">
        <div>
            <h2 class="card__title" id="sw-title">@Ui.Icon("clipboard-check")Floor Social Worker</h2>
            <p class="card__sub">Discipline and behavioural cases referred by the floor staff are opened as tickets and followed up here.</p>
        </div>
        @if (manage) { <a class="btn btn--secondary btn--sm" href="/floor-management/floors/@f.Id/assign?role=SocialWorker" data-modal>@Ui.Icon("user-plus", "icon--sm")Assign Social Worker</a> }
    </div>
    <div class="card__body">
        @foreach (var s in social) { <partial name="~/Views/FloorManagement/_Person.cshtml" model="(s, manage, f.Id)" /> }
        @if (social.Count == 0)
        {
            <div class="empty" style="padding:16px">
                <span class="empty__icon">@Ui.Icon("user")</span>
                <p class="empty__title">No Social Worker assigned yet</p>
                <p class="empty__text">The source does not name the floor's Social Worker. Tickets opened meanwhile stay <strong>Open</strong> until one is assigned.</p>
            </div>
        }
    </div>
</section>
