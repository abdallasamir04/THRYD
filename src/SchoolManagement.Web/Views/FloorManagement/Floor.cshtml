@model FloorDetailsViewModel
@*
    One floor: its organization (Stage Coordinator → Floor Supervisor → Matrons + Floating Matron, and the Floor Social
    Worker as a support role) and its history — every team assignment, current and ended, with dates and reasons.
*@
@using SchoolManagement.Web.Services.FloorManagement
@{
    var f = Model.Floor;
    ViewData["Title"] = f.Name;
    ViewData["Nav"] = "FloorAudit";
    var manage = Model.User.CanManageTeam(f.Id);
    var c = System.Globalization.CultureInfo.InvariantCulture;
}
<span data-refresh-on-save hidden></span>

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/floor-management">Floor Management</a></li><li><span aria-current="page">@f.Name</span></li></ol>
        <h1 class="page-title">@f.Name @if (!f.IsActive) { <span class="badge badge--neutral">Inactive</span> }</h1>
        <p class="page-sub"><span class="fm-range">@Ui.Icon("graduation-cap", "icon--sm")@f.GradeRange</span> · @Ui.Plural(f.OpenReports, "open report", "open reports") · @Ui.Plural(f.OpenTickets, "open ticket", "open tickets")</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/floor-management/reports/new?floor=@f.Id" data-modal>@Ui.Icon("flag")New report</a>
        <a class="btn btn--secondary" href="/floor-management/tickets/new?floor=@f.Id" data-modal>@Ui.Icon("clipboard-check")Open ticket</a>
        @if (Model.User.CanAddFloor) { <a class="btn btn--secondary" href="/floor-management/floors/@f.Id/edit" data-modal>@Ui.Icon("pencil")Edit floor</a> }
        @if (manage) { <a class="btn btn--primary" href="/floor-management/floors/@f.Id/assign" data-modal>@Ui.Icon("user-plus")Assign staff</a> }
    </div>
</div>

<partial name="~/Views/FloorManagement/_Nav.cshtml" model='"floors"' />

<section class="card fm-section" aria-label="@f.Name team">
    <partial name="~/Views/FloorManagement/_FloorHierarchy.cshtml" model="(f, manage, Model.Consultant)" />
</section>

<section class="card" aria-labelledby="fm-history-title">
    <div class="card__head">
        <div>
            <h2 class="card__title" id="fm-history-title">@Ui.Icon("clock")Floor history</h2>
            <p class="card__sub">Every team assignment of the @f.Name, current and ended. Ended assignments are kept, never deleted.</p>
        </div>
    </div>
    @if (Model.History.Count == 0)
    {
        <div class="card__body"><p class="muted">No assignments yet.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table--stack">
                <thead><tr><th scope="col">Staff member</th><th scope="col">Role</th><th scope="col">Grade range</th><th scope="col">From</th><th scope="col">To</th><th scope="col">Status / reason</th></tr></thead>
                <tbody>
                    @foreach (var h in Model.History)
                    {
                        <tr>
                            <td data-label="Staff member"><a href="/staff/@h.StaffId" dir="auto">@h.Name</a></td>
                            <td data-label="Role"><span class="fm-role fm-role--@h.Role.ToString().ToLowerInvariant()">@FloorManagementService.Label(h.Role)</span></td>
                            <td data-label="Grade range">@h.Scope</td>
                            <td data-label="From">@h.Start.ToString("d MMM yyyy", c)</td>
                            <td data-label="To">@(h.End?.ToString("d MMM yyyy", c) ?? "—")</td>
                            <td data-label="Status">@if (h.IsCurrent) { <span class="badge badge--success">Current</span> } else { <span class="muted">@(h.EndReason ?? "Ended")</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
