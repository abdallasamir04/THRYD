@model FloorAuditHome
@*
    Floor Audit: the school's floors with their live audit progress, the three rounds of every session of the day
    (calculated from each session's own start time), Student Access and what needs attention. The board reloads itself.
*@
@{
    ViewData["Title"] = "Floor Audit";
    ViewData["Nav"] = "FloorAudit";
    var date = SchoolWeek.Iso(Model.Date);
}

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li>Daily Operations</li><li>Floor Audit</li></ol>
        <h1 class="page-title">Floor Audit</h1>
        <p class="page-sub">Every floor, classroom and facility through the school day: three audit rounds in every timetable session, and students leaving class and returning.</p>
    </div>
    <div class="page-head__actions">
        <partial name="_QuickActions" model='(Model.User, (int?)null, Model.IsToday ? null : $"/floor-audit/inspections?date={date}&show=pending")' />
    </div>
</div>

<partial name="_Tabs" model='"home"' />
<partial name="_Identity" model="Model.User" />
<partial name="~/Views/Attendance/_SessionDayNav.cshtml" model="Model.Date" />

<div id="fa-board" class="fa-board" data-ajax-list data-fa-live="/floor-audit?date=@date" aria-live="polite">
    <partial name="_HomeBoard" model="Model" />
</div>

@section Scripts {
    <script src="~/js/floor-audit.js" asp-append-version="true"></script>
}
