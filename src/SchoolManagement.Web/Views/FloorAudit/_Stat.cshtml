@model (string Label, string Tone)
@* A Floor Management status pill (rounds, areas, movements): the label in its tone (ok, bad, info, warn, muted). *@
<span class="fa-stat fa-stat--@Model.Tone">@if (Model.Tone == "info") { <span class="fa-stat__pulse" aria-hidden="true"></span> }@Model.Label</span>
