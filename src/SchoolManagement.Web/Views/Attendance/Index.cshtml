@model AttendanceHubViewModel
@*
    Students → Student Attendance: two cards (School Attendance = the existing daily checklist at /arrivals,
    Session Attendance = lesson registers from the class timetable), then each section's statistics for the
    chosen day — kept separate — and the attendance alerts.
*@
@{
    ViewData["Title"] = "Student Attendance";
    ViewData["Nav"] = "Attendance";
    var c = System.Globalization.CultureInfo.InvariantCulture;
    var date = SchoolWeek.Iso(Model.Date);
    var s = Model.School;
    var t = Model.Sessions.Totals;
    var lessons = Model.Sessions.Lessons;
    string Pct(double? p) => p is { } v ? v.ToString("0.#", c) + "%" : "—";
}

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/students/hub">Students</a></li><li><span aria-current="page">Student Attendance</span></li></ol>
        <h1 class="page-title">Student Attendance</h1>
        <p class="page-sub">School Attendance tracks presence at school for the whole day; Session Attendance tracks every scheduled lesson from the class timetable. Choose a section.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/attendance/holidays">@Ui.Icon("calendar")School holidays</a>
        <a class="btn btn--secondary" href="/attendance/alerts">@Ui.Icon("alert-triangle")<span>Alerts</span>@if (Model.Alerts.Pending > 0) { <span class="count-pill">@Model.Alerts.Pending</span> }</a>
    </div>
</div>

<nav class="hub hub--large" aria-label="Student Attendance sections">
    <a class="hub-card hub-card--teal" href="/arrivals?date=@date">
        <span class="hub-card__icon" aria-hidden="true">@Ui.Icon("school")</span>
        <span class="hub-card__body">
            <span class="hub-card__title">School Attendance</span>
            <span class="hub-card__text">Each student's attendance for the whole school day: present, absent or late, arrival time and method, who received them and where, notes and corrections.</span>
            <span class="hub-card__meta">@s.Recorded of @s.Students recorded · @Pct(Model.SchoolPercent) present</span>
        </span>
        <span class="hub-card__go" aria-hidden="true">@Ui.Icon("arrow-right")</span>
    </a>
    <a class="hub-card hub-card--blue" href="/attendance/sessions?date=@date">
        <span class="hub-card__icon" aria-hidden="true">@Ui.Icon("presentation")</span>
        <span class="hub-card__body">
            <span class="hub-card__title">Session Attendance</span>
            <span class="hub-card__text">Attendance in every scheduled lesson — class, period, subject, teacher and time come from the class timetable. Present, Absent, Late or Excused.</span>
            <span class="hub-card__meta">@lessons.Count(l => !l.Lesson.Cancelled) lesson(s) on this day · @t.Pending pending</span>
        </span>
        <span class="hub-card__go" aria-hidden="true">@Ui.Icon("arrow-right")</span>
    </a>
</nav>

<div class="arrival-daynav">
    <partial name="_DayNav" model="Model.Date" />
</div>

@if (Model.Sessions.Holiday is { } h)
{
    <div class="notice notice--warning">@Ui.Icon("calendar")<div class="notice__body"><strong>School holiday: @h.Name</strong>@h.Dates — no lessons are expected and the day does not count for consecutive absences.</div></div>
}

<section class="card att-stats" aria-labelledby="st-school">
    <div class="card__head">
        <div><h2 class="card__title" id="st-school">@Ui.Icon("school")School Attendance · @Model.Date.ToString("ddd d MMM", c)</h2>
            <p class="card__sub">Students without a record are “Not recorded”, never absent. Attendance % = present (on time or late) ÷ recorded.</p></div>
        <a class="btn btn--ghost btn--sm" href="/arrivals?date=@date"><span>Open</span>@Ui.Icon("arrow-right", "icon--sm")</a>
    </div>
    <ul class="summary-tiles summary-tiles--7 att-tiles" aria-label="School attendance statistics">
        <li class="summary-tile"><span class="summary-tile__value num">@s.Students</span><span class="summary-tile__label">Total students</span></li>
        <li class="summary-tile"><span class="summary-tile__value num">@s.Recorded</span><span class="summary-tile__label">Recorded</span></li>
        <li class="summary-tile summary-tile--ok"><span class="summary-tile__value num">@s.Present</span><span class="summary-tile__label">Present</span></li>
        <li class="summary-tile summary-tile--bad"><span class="summary-tile__value num">@s.Absent</span><span class="summary-tile__label">Absent</span></li>
        <li class="summary-tile summary-tile--dup"><span class="summary-tile__value num">@s.Late</span><span class="summary-tile__label">Late</span></li>
        <li class="summary-tile summary-tile--muted"><span class="summary-tile__value num">@s.NotRecorded</span><span class="summary-tile__label">Not recorded</span></li>
        <li class="summary-tile"><span class="summary-tile__value num">@Pct(Model.SchoolPercent)</span><span class="summary-tile__label">Attendance</span></li>
    </ul>
</section>

<section class="card att-stats" aria-labelledby="st-session">
    <div class="card__head">
        <div><h2 class="card__title" id="st-session">@Ui.Icon("presentation")Session Attendance · @Model.Date.ToString("ddd d MMM", c)</h2>
            <p class="card__sub">Expected = students × lessons that have started and are not cancelled. Pending lessons are not recorded yet (never counted as absent). Attendance % = (present + late) ÷ (present + late + absent); excused (@t.Excused) are left out.</p></div>
        <a class="btn btn--ghost btn--sm" href="/attendance/sessions?date=@date"><span>Open</span>@Ui.Icon("arrow-right", "icon--sm")</a>
    </div>
    <ul class="summary-tiles summary-tiles--7 att-tiles" aria-label="Session attendance statistics">
        <li class="summary-tile"><span class="summary-tile__value num">@t.Expected</span><span class="summary-tile__label">Expected sessions</span></li>
        <li class="summary-tile"><span class="summary-tile__value num">@t.Recorded</span><span class="summary-tile__label">Recorded</span></li>
        <li class="summary-tile summary-tile--muted"><span class="summary-tile__value num">@t.Pending</span><span class="summary-tile__label">Pending</span></li>
        <li class="summary-tile summary-tile--ok"><span class="summary-tile__value num">@t.Present</span><span class="summary-tile__label">Present</span></li>
        <li class="summary-tile summary-tile--bad"><span class="summary-tile__value num">@t.Absent</span><span class="summary-tile__label">Absent</span></li>
        <li class="summary-tile summary-tile--dup"><span class="summary-tile__value num">@t.Late</span><span class="summary-tile__label">Late</span></li>
        <li class="summary-tile"><span class="summary-tile__value num">@Pct(t.Percent)</span><span class="summary-tile__label">Attendance</span></li>
    </ul>
</section>

<section class="card att-stats" aria-labelledby="st-alerts">
    <div class="card__head">
        <div><h2 class="card__title" id="st-alerts">@Ui.Icon("alert-triangle")Attendance alerts</h2>
            <p class="card__sub">Raised automatically from the records and updated when attendance is corrected.</p></div>
        <a class="btn btn--ghost btn--sm" href="/attendance/alerts"><span>All alerts</span>@Ui.Icon("arrow-right", "icon--sm")</a>
    </div>
    <ul class="summary-tiles att-tiles" aria-label="Alert statistics">
        <li><a class="summary-tile summary-tile--bad" href="/attendance/alerts?type=absences"><span class="summary-tile__value num">@Model.Alerts.ConsecutivePending</span><span class="summary-tile__label">3 consecutive absences · pending</span></a></li>
        <li><a class="summary-tile summary-tile--dup" href="/attendance/alerts?type=lessons"><span class="summary-tile__value num">@Model.Alerts.SessionPending</span><span class="summary-tile__label">At school, absent from a lesson · pending</span></a></li>
        <li><a class="summary-tile" href="/attendance/alerts"><span class="summary-tile__value num">@Model.Alerts.FollowUp</span><span class="summary-tile__label">Being followed up</span></a></li>
        <li><a class="summary-tile summary-tile--ok" href="/attendance/alerts?state=resolved"><span class="summary-tile__value num">@(Model.Alerts.Resolved + Model.Alerts.Cleared)</span><span class="summary-tile__label">Resolved (@Model.Alerts.Cleared cleared by corrections)</span></a></li>
    </ul>
    @if (Model.RecentAlerts.Count > 0)
    {
        <ul class="att-alert-list">
            @foreach (var a in Model.RecentAlerts)
            {
                <partial name="_AlertItem" model="a" />
            }
        </ul>
    }
    else
    {
        <p class="muted att-empty-line">No pending alerts.</p>
    }
</section>
