@model SessionPickerViewModel
@*
    Session Attendance → choose a class. Each card: the class, its grade and section, students, today's lessons from the
    timetable with the one in progress (or the next one), and how much of today's lesson attendance is recorded.
    Earlier dates (history) through the date bar; a student's lesson history through the search.
*@
@{
    var c = System.Globalization.CultureInfo.InvariantCulture;
    var date = SchoolWeek.Iso(Model.Date);
    var isToday = Model.Date == SchoolWeek.Today;
    ViewData["Title"] = "Session Attendance";
    ViewData["Nav"] = "Attendance";
}

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/students/hub">Students</a></li><li><a href="/attendance?date=@date">Student Attendance</a></li><li>Session Attendance</li></ol>
        <h1 class="page-title">Session Attendance</h1>
        <p class="page-sub">Choose a class: the lesson taking place now opens automatically from the timetable and the school clock.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/attendance/alerts?type=lessons">@Ui.Icon("alert-triangle")Lesson alerts</a>
        <a class="btn btn--secondary" href="/attendance/sessions/reports">@Ui.Icon("chart")Reports</a>
    </div>
</div>

<div class="ses-bar">
    <partial name="_SessionDayNav" model="Model.Date" />
    <form class="ses-find" method="get" action="/attendance/sessions/reports" aria-label="Student lesson history">
        <input type="hidden" name="mode" value="student" />
        <label class="visually-hidden" for="ses-student">Find a student's lesson history</label>
        <select class="select" id="ses-student" name="studentId" data-searchable data-search-notes data-autosubmit>
            <option value="">Find a student's lesson history…</option>
            @foreach (var s in Model.Students)
            {
                <option value="@s.Id" data-note="ID @s.Id · @s.ClassName">@s.Name</option>
            }
        </select>
    </form>
</div>

@if (!Model.IsSchoolDay)
{
    <div class="notice">@Ui.Icon("info")<div class="notice__body"><strong>@(Model.Holiday is null ? "Not a school day." : $"School holiday: {Model.Holiday}.")</strong>No lessons take place on @Model.Date.ToString("dddd d MMMM", c).</div></div>
}

@foreach (var stage in Model.Cards.GroupBy(x => x.Stage))
{
    <section class="ses-stage" aria-labelledby="stage-@stage.Key.GetHashCode()">
        <h2 class="ses-stage__title" id="stage-@stage.Key.GetHashCode()">@stage.Key <span class="count">@stage.Count()</span></h2>
        <div class="ses-cards">
            @foreach (var card in stage)
            {
                var pct = card.Expected == 0 ? 0 : (int)Math.Round(card.Recorded * 100.0 / card.Expected);
                <a class="ses-card @(card.Current is not null ? "is-live" : "")" href="/attendance/sessions/class/@card.ClassId@(isToday ? "" : $"?date={date}")">
                    <span class="ses-card__head">
                        <strong class="ses-card__name">@card.Name</strong>
                        @if (card.Current is not null) { <span class="ses-live">@Ui.Icon("activity", "icon--sm")Live</span> }
                    </span>
                    <span class="ses-card__meta">@string.Join(" · ", new[] { card.Grade, card.Section is null ? null : $"Section {card.Section}", Ui.Plural(card.Students, "student", "students") }.Where(x => x is not null))</span>
                    <span class="ses-card__now">
                        @if (card.Lessons.Count == 0)
                        {
                            <span class="faint">No lessons @(isToday ? "today" : "on this day")</span>
                        }
                        else if (card.Current is { } cur)
                        {
                            <span><strong dir="auto">@cur.Lesson.Subject</strong> · @cur.Lesson.Period · <span class="num">@cur.Lesson.Times12</span></span>
                        }
                        else if (isToday && card.Next is { } nx)
                        {
                            <span><span class="faint">No lesson now · next</span> <strong dir="auto">@nx.Lesson.Subject</strong> at <span class="num">@Arrivals.Time(nx.Lesson.Start)</span></span>
                        }
                        else
                        {
                            <span>@Ui.Plural(card.Lessons.Count, "lesson", "lessons")@(card.Lessons.Any(l => l.Lesson.Start is null) ? " · times not set" : "")</span>
                        }
                    </span>
                    @if (card.Expected > 0)
                    {
                        <span class="ses-card__progress" title="Lesson attendance recorded for lessons that have started">
                            <span class="ses-progress"><span style="width:@pct%"></span></span>
                            <span class="num">@card.Recorded/@card.Expected</span>
                        </span>
                    }
                </a>
            }
        </div>
    </section>
}
