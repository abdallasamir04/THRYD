@model MainDutyPageViewModel
@*
    A Main Duty on a date: its overall time range and calculated status, its Sub-Duties (each with its own time, status,
    required / optional designation and department) and the coverage report (Covered / Not covered, down to the area).
    The board reloads itself every 30 seconds (duties.js).
*@
@{
    var m = Model.Main;
    ViewData["Title"] = m.Name;
    ViewData["Nav"] = "MorningDuty";
    var date = SchoolWeek.Iso(Model.Day.Date);
    var slug = DutyComponents.TypeSlug(m.Type);
}

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/duties?date=@date">Duties</a></li><li>@m.Name</li></ol>
        <h1 class="page-title">@m.Name</h1>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/duties/@slug/schedule">@Ui.Icon("clock")Schedule</a>
        <a class="btn btn--secondary" href="/duties/@slug/report.pdf?date=@date">@Ui.Icon("file-pdf")Coverage report</a>
        <a class="btn btn--ghost" href="/duties/audit?from=@date&to=@date&type=@m.Type">@Ui.Icon("clipboard-check")Duty audit</a>
    </div>
</div>

<nav class="segmented duty-tabs" aria-label="Duty type">
    @foreach (var t in DutyComponents.Types)
    {
        <a href="/duties?type=@DutyComponents.TypeSlug(t)&date=@date" aria-current="@(t == m.Type ? "true" : "false")">@DutyComponents.TypeName(t)</a>
    }
</nav>

<partial name="~/Views/Attendance/_SessionDayNav.cshtml" model="Model.Day.Date" />

<div id="duty-board" data-duty-live aria-live="polite">
    <partial name="_MainBoard" model="Model" />
</div>

@section Scripts {
    <script src="~/js/duties.js" asp-append-version="true"></script>
}
