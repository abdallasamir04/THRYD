@model SchoolCalendarIndexModel
@*
    School Calendar (formerly Academic Calendar): the year's teachers' calendar, quarter by quarter and month by
    month, as printed by the school. Below it, the academic years and their 8-week quarters (unchanged).
*@
@{
    ViewData["Title"] = "School Calendar";
    ViewData["Nav"] = "AcademicCalendar";
    var c = System.Globalization.CultureInfo.InvariantCulture;
    var cal = Model.Calendar;
    var years = Model.Years;
    string Range(DateOnly? s, DateOnly? e) => s is null ? "Dates not set" : $"{s.Value.ToString("ddd d MMM yyyy", c)} – {e!.Value.ToString("ddd d MMM yyyy", c)}";
}
@section Head {
    <link rel="stylesheet" href="~/css/school-calendar.css" asp-append-version="true" />
}
<span data-refresh-on-save hidden></span>

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><span aria-current="page">School Calendar</span></li></ol>
        <h1 class="page-title">School Calendar</h1>
        <p class="page-sub">
            @if (cal.YearName is not null)
            {
                <text>@Model.SchoolName — @cal.YearName.Replace("-", "/") Academic Year Teachers’ Calendar, quarter by quarter. Select a date or an event to see or change it.</text>
            }
            else
            {
                <text>Add an academic year below to start the school calendar.</text>
            }
        </p>
    </div>
    <div class="page-head__actions">
        @if (cal.Years.Count > 1)
        {
            <form method="get" action="/school-calendar" class="sc-year">
                <label class="visually-hidden" for="sc-year">Academic year</label>
                <select class="select" id="sc-year" name="year" data-autosubmit>
                    @foreach (var y in cal.Years)
                    {
                        <option value="@y.Id" selected="@(y.Id == cal.YearId)">@y.Name</option>
                    }
                </select>
            </form>
        }
        @if (cal.YearId is not null)
        {
            <a class="btn btn--primary" href="/school-calendar/events/new?year=@cal.YearId" data-modal>@Ui.Icon("plus")Add event</a>
        }
        <a class="btn btn--secondary" href="/attendance/holidays">@Ui.Icon("calendar")School holidays</a>
    </div>
</div>

@if (cal.CanLoadReference)
{
    <section class="notice notice--info sc-load" aria-labelledby="sc-load-title">
        @Ui.Icon("calendar-days", "icon--lg")
        <div>
            <h2 id="sc-load-title" class="sc-load__title">Load the printed 2026/2027 teachers’ calendar</h2>
            <p>@SchoolCalendarReference.Title: every event line, every coloured date and the quarters as printed (Q2 from 1 Nov, Q3 from 10 Jan, Q4 from 4 Apr). @cal.YearName has no calendar entries yet, so nothing is replaced. The 8-week quarters below do not change.</p>
        </div>
        <form method="post" action="/school-calendar/years/@cal.YearId/load-reference" data-ajax-form
              data-confirm="Adds the printed calendar's events, coloured dates and quarter dates to @cal.YearName. Everything stays editable." data-confirm-title="Load the teachers’ calendar?" data-confirm-button="Load calendar" data-confirm-tone="info">
            @Html.AntiForgeryToken()
            <button class="btn btn--primary" type="submit">@Ui.Icon("download")Load calendar</button>
        </form>
    </section>
}
@if (cal.ToConfirm > 0)
{
    <p class="notice notice--warning sc-confirm-note">@Ui.Icon("alert-circle")<span><strong>@cal.ToConfirm @(cal.ToConfirm == 1 ? "entry needs" : "entries need") the school’s confirmation</strong> (marked “To confirm”): the printed date or wording is not clear. Open one to set its date.</span></p>
}

@if (cal.YearId is not null && cal.Quarters.Count > 0)
{
    <nav class="sc-qnav" aria-label="Quarters">
        @foreach (var q in cal.Quarters)
        {
            <a class="sc-qnav__link sc-q@(q.Number)" href="#q@(q.Number)">
                <strong>Q@(q.Number)</strong>
                <span>@(q.Start is null ? "Dates not set" : $"{q.Start.Value.ToString("d MMM", c)} – {q.End!.Value.ToString("d MMM", c)}")</span>
            </a>
        }
    </nav>

    @foreach (var q in cal.Quarters)
    {
        <section class="sc-quarter sc-q@(q.Number)" id="q@(q.Number)" aria-labelledby="q@(q.Number)-title">
            <header class="sc-quarter__head">
                <span class="sc-quarter__badge" aria-hidden="true">Q@(q.Number)</span>
                <div class="sc-quarter__text">
                    <h2 class="sc-quarter__title" id="q@(q.Number)-title">Quarter @q.Number</h2>
                    <p class="sc-quarter__dates">@(q.Start is null ? "School calendar dates not set" : $"Starts {q.Start.Value.ToString("dddd d MMMM yyyy", c)} · ends {q.End!.Value.ToString("dddd d MMMM yyyy", c)}")</p>
                </div>
                <a class="btn btn--secondary btn--sm" href="/school-calendar/quarters/@q.Id/edit" data-modal>@Ui.Icon("pencil", "icon--sm")Quarter dates</a>
            </header>
            @if (q.Months.Count == 0)
            {
                <div class="empty"><span class="empty__icon">@Ui.Icon("calendar")</span><p class="empty__title">No school calendar dates yet</p><p class="empty__text">Set the first and last day of @q.Name as printed in the school calendar to show its months here.</p></div>
            }
            else
            {
                <div class="sc-months">
                    @foreach (var m in q.Months)
                    {
                        <partial name="_Month" model="(m, cal.YearId!.Value, q.Number)" />
                    }
                </div>
            }
        </section>
    }

    @if (cal.Unplaced.Count > 0)
    {
        <section class="card sc-unplaced" aria-labelledby="sc-unplaced-title">
            <div class="card__head"><h2 class="card__title" id="sc-unplaced-title">@Ui.Icon("inbox")Outside the quarters or hidden</h2><span class="badge badge--neutral">@cal.Unplaced.Count</span></div>
            <div class="card__body">
                <p class="hint">These entries are hidden, or their month is outside every quarter’s school calendar dates. Nothing is left out of the calendar without being listed here.</p>
                <ol class="sc-events">
                    @foreach (var r in cal.Unplaced)
                    {
                        <partial name="_EventLine" model="r" />
                    }
                </ol>
            </div>
        </section>
    }
}

<details class="card sc-admin" open="@(years.Count == 0 || years.Any(y => !y.Quarters.All(q => q.IsConfigured)))">
    <summary class="card__head sc-admin__summary">
        <h2 class="card__title">@Ui.Icon("settings")Academic years and 8-week quarters</h2>
        <span class="hint">Used by Belongings, attendance, timetables and teaching teams</span>
        @Ui.Icon("chevron-down", "sc-admin__chevron")
    </summary>
    <div class="card__body sc-admin__body">
        <p class="hint">Each academic year has four quarters of exactly 8 school weeks (Sunday–Thursday), worked out from each quarter’s start and end dates. The school calendar above groups its months by the quarters’ own printed dates, set in the same form.</p>
        <form class="bl-year-form" action="/school-calendar/years" method="post" data-ajax-form data-loading>
            @Html.AntiForgeryToken()
            <input class="input" name="Name" maxlength="50" required placeholder="e.g. 2026–2027" aria-label="Academic year name" />
            <button class="btn btn--primary" type="submit">@Ui.Icon("plus")Add year</button>
        </form>

        @if (years.Count == 0)
        {
            <div class="empty empty--boxed"><span class="empty__icon">@Ui.Icon("calendar")</span><p class="empty__title">No academic years yet</p><p class="empty__text">Add the current academic year above, then set the dates of its four quarters.</p></div>
        }
        @foreach (var y in years)
        {
            <section class="sc-admin__year" aria-label="@y.Name">
                <div class="sc-admin__yearhead"><h3 class="card__title">@Ui.Icon("calendar")@y.Name</h3><span class="badge @(y.Quarters.All(q => q.IsConfigured) ? "badge--success" : "badge--warning")">@y.Quarters.Count(q => q.IsConfigured) of 4 quarters set</span></div>
                <div class="bl-quarters">
                    @foreach (var q in y.Quarters)
                    {
                        <article class="bl-quarter @(q.IsConfigured ? "" : "is-unset")">
                            <div class="bl-quarter__head">
                                <div>
                                    <h4 class="bl-quarter__name">@q.Name</h4>
                                    <p class="person__meta">@Range(q.StartDate, q.EndDate)</p>
                                </div>
                                <a class="btn btn--secondary btn--sm" href="/school-calendar/quarters/@q.Id/edit" data-modal>@Ui.Icon("pencil", "icon--sm")@(q.IsConfigured ? "Edit" : "Set dates")</a>
                            </div>
                            @if (q.IsConfigured)
                            {
                                <ol class="bl-weeks">
                                    @foreach (var w in q.Weeks)
                                    {
                                        <li title="@string.Join(", ", w.Days.Select(d => d.ToString("ddd d MMM", c)))">
                                            <strong>W@(w.Number)</strong>
                                            <span>@w.WeekStart.ToString("d MMM", c) – @w.WeekEnd.ToString("d MMM", c)</span>
                                            <span class="faint">@w.Days.Count day@(w.Days.Count == 1 ? "" : "s")@(w.Days.Count < 5 ? " (partial)" : "")</span>
                                        </li>
                                    }
                                </ol>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </div>
</details>
