@model IReadOnlyList<IncidentRow>
@* The incident list (used by the Incident page and a student's incident history). *@
<div class="table-wrap">
    <table class="table table--stack inc-table">
        <thead>
            <tr>
                <th scope="col">Reference ID</th>
                <th scope="col">Incident category</th>
                <th scope="col">Date of incident</th>
                <th scope="col">Students involved</th>
                <th scope="col">Severity</th>
                <th scope="col">Status</th>
                <th scope="col">Department</th>
                <th scope="col" class="col-actions"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                var grades = i.GradeSections;
                <tr>
                    <td data-label="Reference ID">
                        <a class="inc-ref" href="/students/behaviour/incidents/@i.Id">@i.Reference</a>
                        <div class="inc-flags">
                            @if (i.IsDraft) { <span class="badge badge--neutral">Draft</span> }
                            @if (i.IsClosed) { <span class="badge badge--neutral">Closed</span> } else { <span class="badge badge--warning">Open record</span> }
                        </div>
                    </td>
                    <td data-label="Category"><strong dir="auto">@i.Category</strong></td>
                    <td data-label="Date" class="num nowrap">@i.Date.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td data-label="Students involved">
                        @if (i.Students.Count == 0)
                        {
                            <span class="faint">None yet</span>
                        }
                        else
                        {
                            <ul class="inc-names">
                                @for (var n = 0; n < Math.Min(4, i.Students.Count); n++)
                                {
                                    var s = i.Students[n];
                                    <li><span class="inc-names__name" dir="auto">@s.Name</span><span class="person__meta">@(n < grades.Count ? grades[n] : "") · @IncidentLabels.Role(s.Role)</span></li>
                                }
                                @if (i.Students.Count > 4)
                                {
                                    <li class="person__meta">+@(i.Students.Count - 4) more</li>
                                }
                            </ul>
                        }
                    </td>
                    <td data-label="Severity"><span class="badge @IncidentLabels.SeverityBadge(i.Severity)" title="@IncidentLabels.Severity(i.Severity)">@IncidentLabels.SeverityShort(i.Severity)</span></td>
                    <td data-label="Status"><span class="badge @IncidentLabels.StatusBadge(i.Status)">@IncidentLabels.Status(i.Status)</span></td>
                    <td data-label="Department" dir="auto">@(string.IsNullOrEmpty(i.Department) ? "—" : i.Department)</td>
                    <td class="col-actions">
                        <div class="row-actions">
                            <a class="icon-btn icon-btn--primary" href="/students/behaviour/incidents/@i.Id" title="Open report" aria-label="Open @i.Reference">@Ui.Icon("eye")</a>
                            @if (!i.IsClosed)
                            {
                                <a class="icon-btn icon-btn--primary" href="/students/behaviour/incidents/@i.Id/report" title="Edit report" aria-label="Edit @i.Reference">@Ui.Icon("pencil")</a>
                            }
                            <a class="icon-btn icon-btn--primary" href="/students/behaviour/incidents/@i.Id/pdf" download title="Official PDF" aria-label="PDF of @i.Reference">@Ui.Icon("file-pdf")</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
