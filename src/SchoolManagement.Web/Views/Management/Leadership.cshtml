@model LeadershipViewModel
@*
    Staff → Management Team → School Leadership: the totals and the School Leadership tiers of the organizational structure
    (Executive Advisory & Governance, Academic Leadership, Parents Care, PR & Counseling, Academic Department Leadership).
    There is no separate member-card section: Management Team members without an organizational position (e.g. the seven
    Management Team leadership positions, a title awaiting confirmation) remain in the Staff Directory, their own profiles
    and position pages.
*@
@{
    ViewData["Title"] = "School Leadership";
    ViewData["Nav"] = "Management";
    var t = Model.Tasks;
}
<span data-refresh-on-save hidden></span>

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/staff">Staff</a></li><li><a href="/management">Management Team</a></li><li><span aria-current="page">School Leadership</span></li></ol>
        <h1 class="page-title">School Leadership</h1>
        <p class="page-sub">Leadership members, their positions and their responsibilities.</p>
    </div>
    <div class="page-head__actions">
        @* Tasks: the global Tasks page and the Tasks module's own Add Task form (modal); one row of two on phones. *@
        <div class="page-head__group" role="group" aria-label="Tasks">
            <a class="btn btn--secondary" href="@SchoolManagement.Web.Controllers.TasksController.Url">@Ui.Icon("clipboard-check")All Tasks</a>
            <a class="btn btn--secondary" href="/management/tasks/create" data-modal>@Ui.Icon("plus")Add Task</a>
        </div>
        <partial name="_Download" model='DownloadLink.Report("/management/leadership/pdf")' />
        <a class="btn btn--primary" href="/management/members/create" data-modal>@Ui.Icon("user-plus")Add Member</a>
    </div>
</div>

<partial name="~/Views/Management/_ManagementNav.cshtml" model="ManagementNav.Leadership" />

<ul class="kpis leadership-kpis" aria-label="School Leadership totals">
    <li><a class="kpi kpi--blue" href="#sl-structure" style="text-decoration:none"><span class="kpi__icon">@Ui.Icon("users")</span><p class="kpi__label">Members</p><p class="kpi__value">@Model.AllMembers.Count</p><p class="kpi__meta">@(Model.Unpositioned == 0 ? "All hold a position" : $"{Model.Unpositioned} without a position")</p></a></li>
    <li><a class="kpi @(Model.Vacant > 0 ? "kpi--full" : "kpi--ok")" href="#sl-structure" style="text-decoration:none"><span class="kpi__icon">@Ui.Icon("crown")</span><p class="kpi__label">Positions filled</p><p class="kpi__value">@Model.Filled<span class="faint" style="font-size:1rem"> / @Model.Positions.Count</span></p><p class="kpi__meta">@(Model.Vacant == 0 ? "No vacancies" : Ui.Plural(Model.Vacant, "vacant position", "vacant positions"))</p></a></li>
    <li><a class="kpi kpi--teal" href="/tasks?status=open" style="text-decoration:none"><span class="kpi__icon">@Ui.Icon("list")</span><p class="kpi__label">Open tasks</p><p class="kpi__value">@t.Open</p><p class="kpi__meta">@t.InProgress in progress · @t.OnHold on hold</p></a></li>
    <li><a class="kpi @(t.Overdue > 0 ? "kpi--full" : "kpi--ok")" href="/tasks?status=overdue" style="text-decoration:none"><span class="kpi__icon">@Ui.Icon("alert-circle")</span><p class="kpi__label">Overdue</p><p class="kpi__value">@t.Overdue</p><p class="kpi__meta">@t.DueToday due today · @t.Completed done</p></a></li>
</ul>

@* The School Leadership tiers of the organizational structure: Executive Advisory & Governance, Academic Leadership,
   Parents Care, PR & Counseling and Academic Department Leadership (the same records as the Organizational Chart). *@
@if (Model.Org is { Tiers.Count: > 0 } org)
{
    <partial name="~/Views/OrgStructure/_Flags.cshtml" model="(org.Flags, Model.CanManageOrg)" />
    <partial name="~/Views/OrgStructure/_Search.cshtml" model='("#sl-structure", org.Tiers, (int?)null, (string?)null, false)' />
    <div class="org-stack" id="sl-structure">
        @foreach (var tier in org.Tiers)
        {
            <partial name="~/Views/OrgStructure/_Tier.cshtml" model="(tier, Model.CanManageOrg)" />
        }
    </div>
}
else
{
    <section class="card">
        <div class="empty">
            <span class="empty__icon">@Ui.Icon("layers")</span>
            <p class="empty__title">The School Leadership structure has not been recorded yet</p>
            <p class="empty__text">Record the official structure, or add tiers, units and positions, on Positions &amp; Assignments.</p>
            <div class="empty__actions"><a class="btn btn--primary" href="@OrgLabels.PositionsHref">@Ui.Icon("settings")Positions &amp; Assignments</a></div>
        </div>
    </section>
}


@section Scripts {
    <script src="~/js/org-structure.js" asp-append-version="true"></script>
}
