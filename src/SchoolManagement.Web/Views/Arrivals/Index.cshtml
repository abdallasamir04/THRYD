@model ArrivalChecklistViewModel
@{
    ViewData["Title"] = "Student Attendance";
    ViewData["Nav"] = "Arrivals";
    var c = Model.Checklist;
    var date = SchoolWeek.Iso(c.Date);
}

@*
    Layout: page head → date bar → session card (class + recording defaults, then the confirmation toggle and
    the late-after deadline on their own row) → summary tiles → checklist card (toolbar, table, save bar).
    Spacing rules live under "Student attendance" in operations.css.
*@
<div class="page-head arrival-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/students/hub">Students</a></li><li>Student Attendance</li></ol>
        <h1 class="page-title">Student Attendance</h1>
        <p class="page-sub">Record each student's arrival for the day. Students without a record are shown as “Not recorded” — never as absent.</p>
    </div>
    <div class="page-head__actions">
        <partial name="_Download" model='DownloadLink.Report("/arrivals/pdf")' />
    </div>
</div>

<div class="arrival-daynav">
    <partial name="_DayNav" model="c.Date" />
</div>

<section class="card arrival-session" aria-label="Session settings">
    @* arrivals.js reads #session-receiver, #session-location, #session-method and #session-confirmed inside [data-arrival-session]. *@
    <div class="arrival-session__body" data-arrival-session>
        <div class="arrival-session__fields">
            @* The class picker reloads the page; display: contents lets its field sit in the same grid as the defaults. *@
            <form class="arrival-session__filter" method="get" action="/arrivals">
                <input type="hidden" name="date" value="@date" />
                <div class="field">
                    <label class="label" for="classId">Class</label>
                    <select class="select" id="classId" name="classId" data-searchable onchange="this.form.submit()">
                        <option value="">All classes</option>
                        @foreach (var cls in Model.Classes)
                        {
                            <option value="@cls.Id" selected="@(c.ClassId == cls.Id)" data-note="@(cls.IsActive ? null : "Inactive")">@cls.Name</option>
                        }
                    </select>
                </div>
            </form>
            <div class="field">
                <label class="label" for="session-receiver">Received by</label>
                <select class="select" id="session-receiver" data-searchable>
                    <option value="">Not recorded</option>
                    @foreach (var s in Model.Staff)
                    {
                        <option value="@s.Id" selected="@(Model.OperatorStaffId == s.Id)" data-note="@s.JobTitle">@s.FullName</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="label" for="session-location">Arrival location</label>
                <input class="input" id="session-location" maxlength="120" placeholder="e.g. Main gate" dir="auto" />
            </div>
            <div class="field">
                <label class="label" for="session-method">Default method</label>
                <select class="select" id="session-method">
                    <option value="">None</option>
                    @foreach (var m in Enum.GetValues<ArrivalMethod>())
                    {
                        <option value="@m">@Arrivals.Method(m)</option>
                    }
                </select>
            </div>
        </div>
        <div class="arrival-session__foot">
            <label class="switch">
                <input type="checkbox" id="session-confirmed" />
                <span class="switch__track" aria-hidden="true"></span>
                <span>Receiving confirmed</span>
            </label>
            <div class="deadline-chip @(c.Deadline is null ? "is-missing" : "")">
                @Ui.Icon("clock", "icon--sm")
                @if (c.Deadline is { } dl)
                {
                    <span>Late after <strong>@dl.ToString("HH:mm")</strong></span>
                }
                else
                {
                    <span>No arrival deadline set — <a href="/settings#arrival">set it in Settings</a> to mark late arrivals.</span>
                }
            </div>
        </div>
    </div>
</section>

@Html.AntiForgeryToken()
<div id="arrival-list" class="arrival-list" data-ajax-list aria-live="polite">
    <partial name="_Checklist" model="Model" />
</div>

@section Scripts {
    <script src="~/js/arrivals.js" asp-append-version="true"></script>
}
