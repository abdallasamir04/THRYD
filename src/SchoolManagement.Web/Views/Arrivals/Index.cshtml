@model DailyAttendanceViewModel
@*
    School Attendance → Daily Attendance: today (school time, Africa/Cairo) by default; choose a class; click a student when
    they arrive. The server records the moment of the click and works out Present / Late (late after the threshold).
    Absent and corrections are separate actions. History and reports are on their own page (/arrivals/history).
*@
@{
    ViewData["Title"] = "School Attendance";
    ViewData["Nav"] = "Arrivals";
    var date = SchoolWeek.Iso(Model.Date);
    var isToday = Model.Day.IsToday;
}
<span data-refresh-on-save hidden></span>

<div class="page-head sa-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/students/hub">Students</a></li><li><a href="/attendance?date=@date">Student Attendance</a></li><li>School Attendance</li></ol>
        <h1 class="page-title">School Attendance</h1>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/attendance/alerts?type=absences">@Ui.Icon("alert-triangle")Absence alerts</a>
    </div>
</div>

<nav class="segmented sa-tabs" aria-label="School Attendance">
    <a href="/arrivals" aria-current="true">@Ui.Icon("check-circle", "icon--sm")Daily Attendance</a>
    <a href="/arrivals/history">@Ui.Icon("chart", "icon--sm")Attendance History &amp; Reports</a>
</nav>

<section class="sa-today" aria-label="Day">
    <div class="sa-today__date">
        <span class="sa-today__icon">@Ui.Icon("calendar")</span>
        <div>
            <span class="sa-today__eyebrow">@(isToday ? "Today" : Model.Day.IsFuture ? "Upcoming day" : "Past day")</span>
            <strong class="sa-today__day">@Model.Date.ToString("dddd, d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</strong>
        </div>
    </div>
    @if (isToday)
    {
        <div class="sa-today__clock" title="School time (Cairo)">@Ui.Icon("clock")<span data-att-clock>@Arrivals.Time(TimeOnly.FromDateTime(SchoolTime.Current.Now))</span><small>Cairo</small></div>
    }
    <span class="sa-rule">@Ui.Icon("info", "icon--sm")@(Model.Rules.Start is { } start ? $"Present until {Arrivals.Time(start)} · Late after · " : "")Registration closes @Arrivals.Time(Model.Rules.Cutoff)</span>
    <div class="sa-today__nav">
        <a class="icon-btn icon-btn--bordered" href="@Context.Request.WithQuery(("date", SchoolWeek.Iso(Model.Date.AddDays(-1))))" aria-label="Previous day" title="Previous day">@Ui.Icon("chevron-left")</a>
        <form method="get" action="/arrivals" class="sa-today__picker">
            @if (Model.ClassId is { } cid) { <input type="hidden" name="classId" value="@cid" /> } else if (Model.AllClasses) { <input type="hidden" name="classId" value="all" /> }
            <label class="visually-hidden" for="sa-date">Go to date</label>
            <input class="input picker" type="date" id="sa-date" name="date" value="@date" max="@SchoolWeek.Iso(SchoolWeek.Today)" data-datepicker data-autosubmit data-empty-text="Choose a date" />
        </form>
        @if (!isToday)
        {
            <a class="icon-btn icon-btn--bordered" href="@Context.Request.WithQuery(("date", SchoolWeek.Iso(Model.Date.AddDays(1))))" aria-label="Next day" title="Next day">@Ui.Icon("chevron-right")</a>
            <a class="btn btn--primary btn--sm" href="@Context.Request.WithQuery(("date", null))">Back to today</a>
        }
    </div>
</section>

<form class="sa-class" method="get" action="/arrivals" data-list-filter="#sa-daily" aria-label="Class">
    @if (!isToday) { <input type="hidden" name="date" value="@date" /> }
    <label class="sa-class__label" for="sa-class">@Ui.Icon("door", "icon--sm")Class</label>
    <select class="select" id="sa-class" name="classId" data-searchable>
        <option value="">Choose a class…</option>
        <option value="all" selected="@Model.AllClasses">All classes</option>
        @foreach (var cls in Model.Classes)
        {
            <option value="@cls.Id" selected="@(Model.ClassId == cls.Id)" data-note="@(cls.IsActive ? $"{cls.StudentCount} students" : "Inactive")">@cls.Name</option>
        }
    </select>
</form>

<div id="sa-daily" data-ajax-list aria-live="polite">
    <partial name="_Daily" model="Model" />
</div>

@section Scripts {
    <script src="~/js/arrivals.js" asp-append-version="true"></script>
}
