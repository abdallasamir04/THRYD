@model ArrivalCorrectionModel
@*
    Correction: the only way to change a saved attendance record. The chosen outcome (Present, Late or Absent), the
    arrival time and notes are saved; the previous and new values, the reason, when and who are kept in
    StudentArrivalCorrections. Older records' method / location / receiver stay in that history.
*@
@{
    var modal = Context.Request.IsAjax();
    var r = Model.Record!;
    if (modal) { Layout = null; }
    else { ViewData["Title"] = "Correct attendance"; ViewData["Nav"] = "Arrivals"; }
    var current = r.Outcome;
}

<div class="@(modal ? "modal__content" : "card form-page")" data-modal-wide>
    <form action="/arrivals/@Model.Id/correct" method="post" data-ajax-form="@(modal ? "" : null)" data-loading style="display:contents">
        @Html.AntiForgeryToken()
        <div class="modal__head">
            <span class="modal__icon modal__icon--warning">@Ui.Icon("pencil", "icon--lg")</span>
            <div>
                <h2 class="modal__title" dir="auto">Correct attendance — @r.StudentName</h2>
                <p class="modal__sub">@r.ClassName · @r.Date.ToString("dddd d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
            </div>
            <button class="icon-btn modal__close" type="button" data-modal-close aria-label="Close">@Ui.Icon("x")</button>
        </div>
        <div class="modal__body form-grid">
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
            <div class="sa-current">
                <span class="sa-current__label">Currently</span>
                <span class="badge badge--dot @(current is { } o ? Arrivals.Badge(o) : "badge--neutral")">@Arrivals.Label(current)</span>
                @if (r.Time is { } t) { <span class="num">@Arrivals.Time(t)</span> }
                <span class="sa-current__by">Recorded by @(r.RecordedBy ?? "—")@(r.RecordedAt is { } at ? $" · {SchoolTime.Current.ToLocal(at):d MMM, h:mm tt}" : "")@(r.Corrections > 0 ? $" · corrected {r.Corrections}× before" : "")</span>
            </div>
            <fieldset class="field">
                <legend class="label">Correct status</legend>
                <div class="seg-toggle sa-outcome" data-att-outcome>
                    <label><input type="radio" name="Outcome" value="Present" checked="@(Model.Outcome == ArrivalOutcome.Present)" /><span>Present</span></label>
                    <label><input type="radio" name="Outcome" value="Late" checked="@(Model.Outcome == ArrivalOutcome.Late)" /><span>Late</span></label>
                    <label><input type="radio" name="Outcome" value="Absent" checked="@(Model.Outcome == ArrivalOutcome.Absent)" /><span>Absent</span></label>
                </div>
                <span class="hint">Normally @(Model.Rules?.Start is { } st ? $"Present until {Arrivals.Time(st)}, Late after" : "Present") and Absent with no arrival by @Arrivals.Time(Model.Rules?.Cutoff). A correction can set any status (e.g. an excused late arrival); the reason is kept.</span>
            </fieldset>
            <div class="form-grid form-grid--2">
                <div class="field" data-att-time-field>
                    <label class="label" for="Time">Arrival time</label>
                    <input class="input picker" type="time" id="Time" name="Time" value="@Model.Time" data-timepicker data-empty-text="Choose the time" />
                    <span class="hint">Not used for Absent.</span>
                    <span asp-validation-for="Time" class="field-validation-error"></span>
                </div>
                <div class="field">
                    <label class="label" asp-for="Notes">Notes</label>
                    <input class="input" asp-for="Notes" maxlength="500" dir="auto" />
                </div>
            </div>
            <div class="field">
                <label class="label" asp-for="Reason">Reason for the correction <span class="req" aria-hidden="true">*</span></label>
                <input class="input" asp-for="Reason" maxlength="500" dir="auto" placeholder="e.g. Recorded for the wrong student; late arrival excused by the principal" data-autofocus />
                <span asp-validation-for="Reason" class="field-validation-error"></span>
                <span class="hint">The previous values, your reason, the time and your name are kept in the correction history.</span>
            </div>
        </div>
        <div class="modal__foot">
            @if (modal)
            {
                <button class="btn btn--secondary" type="button" data-modal-close>Cancel</button>
            }
            else
            {
                <a class="btn btn--secondary" href="/arrivals?date=@SchoolWeek.Iso(r.Date)&classId=@r.ClassId">Cancel</a>
            }
            <button class="btn btn--primary" type="submit">@Ui.Icon("check")Save correction</button>
        </div>
    </form>
</div>
