@model ArrivalChecklistViewModel
@{
    var c = Model.Checklist;
    var s = c.Summary;
    var date = SchoolWeek.Iso(c.Date);
    var isFuture = c.Date > SchoolWeek.Today;
    string Tab(string key) => Model.Show == key ? "true" : "false";
}

<ul class="summary-tiles summary-tiles--7" aria-label="Arrival summary">
    <li class="summary-tile"><span class="summary-tile__value num">@s.Students</span><span class="summary-tile__label">Students</span></li>
    <li class="summary-tile"><span class="summary-tile__value num">@s.Recorded</span><span class="summary-tile__label">Recorded</span></li>
    <li class="summary-tile summary-tile--ok"><span class="summary-tile__value num">@s.Present</span><span class="summary-tile__label">Present</span></li>
    <li class="summary-tile summary-tile--bad"><span class="summary-tile__value num">@s.Absent</span><span class="summary-tile__label">Absent</span></li>
    <li class="summary-tile summary-tile--dup"><span class="summary-tile__value num">@s.Late</span><span class="summary-tile__label">Late</span></li>
    <li class="summary-tile"><span class="summary-tile__value num">@(s.OnTimePercent is { } p ? p.ToString("0.#") + "%" : "—")</span><span class="summary-tile__label">On time</span></li>
    <li class="summary-tile summary-tile--muted"><span class="summary-tile__value num">@s.NotRecorded</span><span class="summary-tile__label">Not recorded</span></li>
</ul>

<section class="card table-card arrival-card" aria-label="Arrival checklist">
    <div class="toolbar arrival-toolbar">
        <div class="segmented" role="group" aria-label="Show">
            <button type="button" data-arrival-filter="all" aria-pressed="@Tab("all")">All</button>
            <button type="button" data-arrival-filter="missing" aria-pressed="@Tab("missing")">Not recorded <span class="count">@s.NotRecorded</span></button>
            <button type="button" data-arrival-filter="late" aria-pressed="@Tab("late")">Late <span class="count">@s.Late</span></button>
            <button type="button" data-arrival-filter="absent" aria-pressed="@Tab("absent")">Absent <span class="count">@s.Absent</span></button>
        </div>
        <div class="toolbar__search input-icon">
            @Ui.Icon("search")
            <input class="input" type="search" placeholder="Find a student…" aria-label="Find a student" data-arrival-search dir="auto" />
        </div>
        <div class="toolbar__end">
            @if (!isFuture && s.NotRecorded > 0)
            {
                <button class="btn btn--secondary btn--sm" type="button" data-arrival-all-present>@Ui.Icon("check", "icon--sm")Mark shown as present now</button>
            }
        </div>
    </div>

    @if (isFuture)
    {
        <div class="notice notice--warning arrival-notice">@Ui.Icon("alert-triangle")<div class="notice__body"><strong>This date is in the future.</strong>Arrivals can be recorded on the day or afterwards.</div></div>
    }

    @if (c.Rows.Count == 0)
    {
        <div class="empty">
            <span class="empty__icon">@Ui.Icon("graduation-cap")</span>
            <p class="empty__title">No students to show</p>
            <p class="empty__text">The checklist lists students from the Student Directory who were enrolled on this date.</p>
            <div class="empty__actions"><a class="btn btn--secondary" href="/students">Go to Students</a></div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table arrival-table" data-arrival-table data-date="@date" data-deadline="@(c.Deadline?.ToString("HH:mm:ss"))" data-initial-filter="@Model.Show">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Arrival</th>
                        <th scope="col">Time</th>
                        <th scope="col">Method</th>
                        <th scope="col">Notes</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in c.Rows)
                    {
                        if (!r.IsRecorded)
                        {
                            <tr class="arrival-row" data-student="@r.StudentId" data-state="missing" data-name="@r.StudentName.ToLowerInvariant()">
                                <td><div class="arrival-cell"><div class="person__name" dir="auto">@r.StudentName</div><span class="badge badge--class">@r.ClassName</span></div></td>
                                <td>
                                    @if (!isFuture)
                                    {
                                        <div class="seg-toggle" role="radiogroup" aria-label="Arrival of @r.StudentName">
                                            <label><input type="radio" name="st-@r.StudentId" value="Present" data-field="status" /><span>Present</span></label>
                                            <label><input type="radio" name="st-@r.StudentId" value="Absent" data-field="status" /><span>Absent</span></label>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="time-field">
                                        <input class="input input--sm" type="time" step="1" data-field="time" aria-label="Arrival time of @r.StudentName" disabled="@isFuture" />
                                        <button class="btn btn--ghost btn--sm" type="button" data-now disabled="@isFuture">Now</button>
                                    </div>
                                </td>
                                <td>
                                    <select class="select input--sm" data-field="method" aria-label="Arrival method of @r.StudentName" disabled="@isFuture">
                                        <option value="">—</option>
                                        @foreach (var m in Enum.GetValues<ArrivalMethod>())
                                        {
                                            <option value="@m">@Arrivals.Method(m)</option>
                                        }
                                    </select>
                                </td>
                                <td><input class="input input--sm" data-field="notes" maxlength="500" aria-label="Notes for @r.StudentName" dir="auto" disabled="@isFuture" /></td>
                                <td><div class="arrival-cell"><span class="badge badge--neutral" data-row-status>Not recorded</span><div class="row-error" data-row-error></div></div></td>
                            </tr>
                        }
                        else
                        {
                            var late = r.Late == LateStatus.Late;
                            var state = r.Status == ArrivalStatus.Absent ? "absent" : late ? "late" : "present";
                            <tr class="arrival-row is-recorded @(late ? "is-late" : "") @(r.Status == ArrivalStatus.Absent ? "is-absent" : "")" data-student="@r.StudentId" data-state="@state" data-name="@r.StudentName.ToLowerInvariant()">
                                <td><div class="arrival-cell"><div class="person__name" dir="auto"><a href="/students/profile/@r.StudentId">@r.StudentName</a></div><span class="badge badge--class">@r.ClassName</span></div></td>
                                <td>
                                    @if (r.Status == ArrivalStatus.Present)
                                    {
                                        <span class="badge badge--success badge--dot">Present</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--error badge--dot">Absent</span>
                                    }
                                </td>
                                <td class="num">
                                    @if (r.Time is { } t)
                                    {
                                        <div class="arrival-time">
                                            <strong>@t.ToString(t.Second == 0 ? "HH:mm" : "HH:mm:ss")</strong>
                                            @if (late) { <span class="badge badge--error">Late</span> }
                                            else if (r.Late == LateStatus.OnTime) { <span class="badge badge--success">On time</span> }
                                        </div>
                                    }
                                    else { <span class="faint">—</span> }
                                </td>
                                <td><div class="arrival-cell"><span>@(r.Status == ArrivalStatus.Present ? Arrivals.Method(r.Method) : "—")</span>@if (r.Location is not null) { <div class="person__meta" dir="auto">@r.Location</div> }</div></td>
                                <td><div class="arrival-cell"><span dir="auto">@(r.Notes ?? "")</span>@if (r.ReceivedByName is not null) { <div class="person__meta" dir="auto">Received by @r.ReceivedByName@(r.Confirmed ? " ✓" : "")</div> }</div></td>
                                <td>
                                    <div class="arrival-cell">
                                        <div class="person__meta">Recorded by @(r.RecordedBy ?? "—")@(r.Corrections > 0 ? $" · corrected {r.Corrections}×" : "")</div>
                                        <a class="btn btn--ghost btn--sm" href="/arrivals/@r.RecordId/correct" data-modal>@Ui.Icon("pencil", "icon--sm")Correct</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (!isFuture && s.NotRecorded > 0)
        {
            <div class="sticky-actions arrival-save">
                <span class="muted" data-arrival-pending>No changes yet.</span>
                <button class="btn btn--primary btn--lg" type="button" data-arrival-save disabled>@Ui.Icon("check")Save entries</button>
            </div>
        }
    }
</section>
