@{
    var code = ViewData["Code"] as int? ?? 500;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}
<div class="card">
    <div class="empty">
        <span class="empty__icon">@Ui.Icon(code == 404 ? "search" : "alert-triangle")</span>
        <p class="empty__title">@(code == 404 ? "This page does not exist" : "Something went wrong")</p>
        <p class="empty__text">
            @(code == 404 ? "The link may be old, or the record was deleted." : "The request could not be completed. Nothing else was changed. Try again, and if it keeps happening, note the reference below.")
        </p>
        @if (code != 404 && ViewData["RequestId"] is string id)
        {
            <p class="faint mono">Reference: @id</p>
        }
        <div class="empty__actions"><a class="btn btn--primary" href="/">Back to dashboard</a></div>
    </div>
</div>
