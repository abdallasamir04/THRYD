@*
    Application shell: grouped sidebar (brand + navigation) next to the workspace (glass topbar + page).
    Below 1024px the sidebar sits above the page as a compact strip (brand + one scrollable row of the same links).
    Planned modules (Daily Operations, School QA) are shown muted with "Soon": no link, no route.
*@
@inject ISettingsService Settings
@inject IDashboardService Dashboard
@inject ICurrentUser CurrentUser
@inject SchoolManagement.Web.Services.Ptc.IPtcOperationsService PtcOperations
@inject SchoolManagement.Web.Services.Accounts.IStaffAccessEvaluator StaffAccess
@inject Microsoft.Extensions.Options.IOptionsMonitor<SchoolManagement.Web.Services.Accounts.AccountOptions> AccountSettings
@{
    var operatorName = CurrentUser.Name;
    // Super Admin (Administration mode: no "Working as" identity) — full access, "Working as" optional.
    var superAdmin = CurrentUser.IsSuperAdmin;
    var profile = await Settings.GetProfileAsync();
    var counts = await Dashboard.NavCountsAsync();
    // "My PTC" for a staff member (Working as) who has PTC interviews in a Published or Completed event.
    var myPtc = !superAdmin && await PtcOperations.HasInterviewsAsync();
    // Signed in: the account is the identity. A staff account sees only what it may open (least privilege, also enforced on the server).
    var signedIn = User.Identity?.IsAuthenticated == true;
    var staffNav = signedIn && !superAdmin;
    var access = staffNav ? await StaffAccess.SummaryAsync() : null;
    // Sign-in switched off: the navigation is the one from before sign-in (no Staff accounts entry; the page stays at its address).
    var signInOn = AccountSettings.CurrentValue.RequireAuthentication;
    var current = ViewData["Nav"] as string ?? "";
    // Every page under Staff (academic and management) highlights the single Staff entry.
    if (current is "Departments" or "StaffMembers" or "Teachers" or "Workload" or "Timetable" or "Management") current = "Staff";
    // Belongings, Student Attendance and Behavioural / Discipline open from the Students landing page.
    if (current is "Belongings" or "Arrivals" or "Attendance" or "Behaviour") current = "Students";
    // Duties is the one entry for duties (its landing page: Duties and Duty Audit): the duty pages, P.E. / activities (from
    // its cards), Duty Audit, Staff Duty Records and staff duty profiles / evaluations all highlight it.
    if (current is "StaffDuty" or "MorningDuty" or "PE") current = "DutyAudit";
    var title = ViewData["Title"] as string ?? "Dashboard";

    // "Staff" and "Students" are one entry each: their landing pages lead to every submodule, so the
    // sidebar does not list them all.
    var groups = new (string Title, (string Key, string? Href, string Label, string Icon, int? Count)[] Items)[]
    {
        ("People", new (string, string?, string, string, int?)[]
        {
            ("Staff", "/staff", "Staff", "users", counts.Teachers + counts.Management),
            ("Students", "/students/hub", "Students", "graduation-cap", counts.Students),
        }),
        ("Academics", new (string, string?, string, string, int?)[]
        {
            ("Classes", "/classes", "Classes", "door", counts.Classes),
            ("Timetables", "/timetables", "Timetables", "calendar", null),
            ("AcademicCalendar", "/school-calendar", "School Calendar", "calendar-days", null),
        }.Concat(superAdmin
            // PTC administration is Super Admin only (checked again on every request); nobody else sees the entry.
            ? new (string, string?, string, string, int?)[] { ("PTC", "/ptc", "PTC", "users", null) }
            : myPtc ? new (string, string?, string, string, int?)[] { ("MyPtc", "/ptc/my", "My PTC interviews", "clock", null) }
            : []).ToArray()),
        ("Daily Operations", new (string, string?, string, string, int?)[]
        {
            ("DutyAudit", "/duties", "Duties", "shield-check", null),
            ("FloorAudit", "/floor-management", "Floor Management", "school", null),
            ("Tasks", "/tasks", "Tasks", "list-checks", null),
        }),
        ("Data", new (string, string?, string, string, int?)[]
        {
            ("ImportExport", "/import-export", "Import / Export", "sheet", null),
        }),
        ("Coming next", new (string, string?, string, string, int?)[]
        {
            ("SchoolQA", null, "School QA", "clipboard-check", null),
            // Upcoming (no page or route yet): shown disabled with a "Soon" badge, like School QA.
            ("Admission", null, "Admission", "user-plus", null),
        }),
        ("System", new (string, string?, string, string, int?)[]
        {
            ("Settings", "/settings", "Settings", "settings", null),
        }.Concat(signInOn ? [("StaffAccounts", "/staff/accounts", "Staff accounts", "lock", null)] : Array.Empty<(string, string?, string, string, int?)>()).ToArray()),
    };
    if (staffNav)
    {
        // A signed-in staff member: their own pages, plus the modules they hold a specific grant for.
        var mine = new List<(string, string?, string, string, int?)> { ("Me", "/me", "My dashboard", "dashboard", null) };
        if (myPtc) mine.Add(("MyPtc", "/ptc/my", "My PTC interviews", "clock", null));
        var modules = new List<(string, string?, string, string, int?)>();
        if (access!.FloorTeam) modules.Add(("FloorAudit", "/floor-management", "Floor Management", "school", null));
        if (access.DutyAudit) modules.Add(("DutyAudit", "/duties", "Duties", "shield-check", null));
        if (access.OrgStructure) modules.Add(("Management", "/management", "Management", "briefcase", null));
        if (access.StudentRecords) { modules.Add(("Students", "/students/hub", "Students", "graduation-cap", null)); modules.Add(("Classes", "/classes", "Classes", "door", null)); }
        groups = modules.Count == 0
            ? [("You", mine.ToArray())]
            : [("You", mine.ToArray()), ("Modules", modules.ToArray())];
    }
    var group = current == "Dashboard" ? "Overview"
        : groups.FirstOrDefault(g => g.Items.Any(i => i.Key == current)).Title ?? "";
    var flash = TempData[SchoolManagement.Web.Controllers.AppController.ToastKey] as string;

    // Global Back button (topbar) — a permanent part of the THRYD header, rendered on EVERY page that uses this layout.
    // There is deliberately no per-page switch to hide it: a page's own contextual back link ("All classes", "Back to
    // teachers"…) is shown in addition to it, never instead of it. A page may only set ViewData["BackButtonHref"] to choose
    // where Back goes when there is no previous page of this app in the browser history. app.js (Back button section)
    // returns to the previous page of this app when there is one; otherwise to that fallback, else the page's parent (its
    // last breadcrumb link), else the Dashboard — it never leaves the application.
    var backHref = ViewData["BackButtonHref"] as string;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@title · @profile.SchoolName</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="preload" href="~/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/thryd-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/floor-audit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/org-structure.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student-profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/floor-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/skeleton.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/img/logo-mark.png" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <partial name="_Icons" />
    <a class="skip-link" href="#content">Skip to content</a>

    <div class="shell">
        <aside class="sidebar" id="sidebar" aria-label="Main navigation">
            <div class="sidebar__head">
                <a class="brand brand--logo" href="/">
                    @* THRYD logo: transparent copies of E:\noo\logo.jpeg, one for each theme. *@
                    <img class="brand__logo brand__logo--light" src="~/img/logo-light.png" asp-append-version="true" alt="THRYD" width="640" height="123" />
                    <img class="brand__logo brand__logo--dark" src="~/img/logo-dark.png" asp-append-version="true" alt="THRYD" width="640" height="123" />
                </a>
            </div>

            <nav class="nav" aria-label="Sections">
                <ul class="nav__list">
                    <li>
                        <a class="nav__link" href="/" aria-current="@(current == "Dashboard" ? "page" : null)">
                            @Ui.Icon("dashboard")<span>Dashboard</span>
                        </a>
                    </li>
                </ul>

                @foreach (var (groupTitle, items) in groups)
                {
                    var id = "nav-" + groupTitle.ToLowerInvariant().Replace(' ', '-');
                    <details class="nav__section" open>
                        <summary class="nav__summary" id="@id"><span>@groupTitle</span>@Ui.Icon("chevron-down")</summary>
                        <ul class="nav__list" aria-labelledby="@id">
                            @foreach (var (key, href, label, icon, count) in items)
                            {
                                <li>
                                    @if (href is null)
                                    {
                                        <span class="nav__link nav__link--planned" aria-disabled="true">
                                            @Ui.Icon(icon)<span>@label</span>
                                            <span class="nav__soon">Soon<span class="visually-hidden"> — not available yet</span></span>
                                        </span>
                                    }
                                    else
                                    {
                                        <a class="nav__link" href="@href" aria-current="@(current == key ? "page" : null)">
                                            @Ui.Icon(icon)<span>@label</span>
                                            @if (count is not null)
                                            {
                                                <span class="nav__count" aria-label="@count records">@Ui.Count(count.Value)</span>
                                            }
                                        </a>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
            </nav>

            <div class="sidebar__foot">
                @Ui.Icon("database")
                <p><strong>Saved to SQL Server</strong>Every change and import is stored in the school database.</p>
            </div>
        </aside>

        <div class="main">
            <header class="topbar">
                <div class="topbar__start">
                    @* Global Back button: always rendered (see the note at the top of this file). Do not wrap it in a condition. *@
                    @if (backHref is not null)
                    {
                        <a class="btn btn--secondary btn--sm topbar__back" href="@backHref" data-back data-back-fixed title="Back to the previous page">
                            @Ui.Icon("arrow-left")<span class="topbar__back-text">Back</span>
                        </a>
                    }
                    else
                    {
                        <a class="btn btn--secondary btn--sm topbar__back" href="/" data-back title="Back to the previous page">
                            @Ui.Icon("arrow-left")<span class="topbar__back-text">Back</span>
                        </a>
                    }
                    <p class="trail">
                        <span class="trail__group">@group</span>
                        <span class="trail__sep" aria-hidden="true">/</span>
                        <span class="trail__page">@title</span>
                    </p>
                </div>
                <div class="topbar__actions">
                    <partial name="_SchoolClock" />
                    @if (!string.IsNullOrEmpty(profile.AcademicYear))
                    {
                        <span class="chip chip--brand">@profile.AcademicYear</span>
                    }
                    <button class="icon-btn icon-btn--bordered theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Dark mode">
                        @Ui.Icon("moon", "icon--moon")@Ui.Icon("sun", "icon--sun")
                    </button>
                    <span class="topbar__divider" aria-hidden="true"></span>
                    @if (signedIn)
                    {
                        <details class="account-menu">
                            <summary class="account" title="Signed in as @operatorName">
                                <span class="avatar avatar--@(superAdmin ? "violet" : Ui.Tone(operatorName))" aria-hidden="true">@(superAdmin ? "SA" : Ui.Initials(operatorName))</span>
                                <span class="account__text">
                                    <span class="account__name" dir="auto">@operatorName</span>
                                    <span class="account__role">@(superAdmin ? "Super Admin · full access" : "Staff")</span>
                                </span>
                            </summary>
                            <div class="account-menu__panel">
                                <a href="@(superAdmin && CurrentUser.StaffId is null ? "/staff/accounts" : "/me")">@Ui.Icon("dashboard", "icon--sm")@(superAdmin && CurrentUser.StaffId is null ? "Staff accounts" : "My dashboard")</a>
                                <a href="/account/password">@Ui.Icon("lock", "icon--sm")Change password</a>
                                <form action="/account/logout" method="post">@Html.AntiForgeryToken()<button type="submit">@Ui.Icon("power", "icon--sm")Sign out</button></form>
                            </div>
                        </details>
                    }
                    else if (superAdmin)
                    {
                        <a class="account" href="/settings#operator" title="Super Admin — full access. “Working as” is optional (Settings).">
                            <span class="avatar avatar--violet" aria-hidden="true">SA</span>
                            <span class="account__text">
                                <span class="account__name">Super Admin</span>
                                <span class="account__role">Full access</span>
                            </span>
                        </a>
                    }
                    else
                    {
                        <a class="account" href="/settings#operator" title="@(operatorName is null ? "Choose who you are working as" : "Working as — self-selected, not a sign-in")">
                            <span class="avatar avatar--@Ui.Tone(operatorName ?? profile.SchoolName)" aria-hidden="true">@Ui.Initials(operatorName ?? profile.SchoolName)</span>
                            <span class="account__text">
                                <span class="account__name" dir="auto">@(operatorName ?? "Administration")</span>
                                <span class="account__role">@(operatorName is null ? "Set “Working as”" : "Working as · not verified")</span>
                            </span>
                        </a>
                    }
                </div>
            </header>

            <main class="workspace" id="content" tabindex="-1">
                @RenderBody()
            </main>

            <footer class="footer">
                @profile.SchoolName · School Management · © @SchoolTime.Now.Year
            </footer>
        </div>
    </div>

    <dialog id="app-modal" class="modal" aria-label="Dialog"></dialog>

    @* The shared THRYD confirmation / message dialog (app.js: App.confirm, App.alert, data-confirm forms, unsaved changes). *@
    <dialog id="confirm-dialog" class="modal modal--confirm" role="alertdialog" aria-labelledby="confirm-title" aria-describedby="confirm-text">
        <div class="modal__content">
            <div class="modal__head">
                <span class="modal__icon modal__icon--danger" data-confirm-icon>@Ui.Icon("alert-triangle", "icon--lg")</span>
                <div>
                    <h2 class="modal__title" id="confirm-title" data-confirm-title>Are you sure?</h2>
                    <p class="modal__sub" id="confirm-text" data-confirm-text></p>
                </div>
            </div>
            <div class="modal__foot">
                <button class="btn btn--secondary" type="button" data-confirm-cancel>Cancel</button>
                <button class="btn btn--danger" type="button" data-confirm-ok>Delete</button>
            </div>
        </div>
    </dialog>

    @if (!string.IsNullOrEmpty(flash))
    {
        var parts = flash.Split('|', 2);
        <div id="flash" hidden data-type="@parts[0]" data-message="@(parts.Length > 1 ? parts[1] : parts[0])"></div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script src="~/js/school-clock.js" asp-append-version="true"></script>
    <script src="~/js/thryd-ui.js" asp-append-version="true"></script>
    <script src="~/js/operations.js" asp-append-version="true"></script>
    <script src="~/js/staff.js" asp-append-version="true"></script>
    <script src="~/js/tasks.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
