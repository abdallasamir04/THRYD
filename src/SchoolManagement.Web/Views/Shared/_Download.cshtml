@model DownloadLink
@*
    The one PDF download button of the application (same icon, label style and placement everywhere).
    Without JavaScript the link exports the filters of the page as it was loaded; app.js swaps in the
    current query string on click, so filters changed in place are exported too.
*@
<a class="btn btn--secondary@(Model.Small ? " btn--sm" : "") btn--download" href="@(Model.Path + Context.Request.QueryString)" data-download="@Model.Path"
   title="@Model.Label as a PDF (landscape)" download>@Ui.Icon("file-pdf", Model.Small ? "icon--sm" : null)@Model.Label</a>
