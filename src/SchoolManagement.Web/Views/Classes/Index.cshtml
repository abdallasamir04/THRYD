@model HubViewModel
@*
    Classes landing page: four stage cards (KG Stages, Elementary, Middle School, High School), the same
    large cards as the Staff landing page. A class's stage comes from its grade (see ClassStages).
*@
@{
    ViewData["Title"] = Model.Title;
    ViewData["Nav"] = Model.Nav;
}

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs">
            @foreach (var (label, href) in Model.Crumbs)
            {
                <li>@if (href is null) { <span aria-current="page">@label</span> } else { <a href="@href">@label</a> }</li>
            }
        </ol>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-sub">@Model.Subtitle</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/classes/all">@Ui.Icon("list")All classes</a>
        @* Four independent downloads (only here: not on the Students page or the stage pages). PDF = red icon, Excel = green icon. *@
        <div class="class-downloads" role="group" aria-label="Download reports">
            <a class="btn btn--secondary btn--download dl-pdf" href="/classes/pdf" data-download="/classes/pdf" download
               title="Classes summary as a PDF (portrait)" aria-label="Download Summary PDF">@Ui.Icon("file-pdf")<span><span class="dl-verb">Download </span>Summary PDF</span></a>
            <a class="btn btn--secondary btn--download dl-xlsx" href="/classes/summary-excel" download
               title="Classes summary as an Excel workbook (.xlsx)" aria-label="Download Summary Excel">@Ui.Icon("sheet")<span><span class="dl-verb">Download </span>Summary Excel</span></a>
            <a class="btn btn--secondary btn--download dl-pdf" href="/classes/students-report" download
               title="Every class and its students as a PDF: one page per class" aria-label="Download Students PDF">@Ui.Icon("file-pdf")<span><span class="dl-verb">Download </span>Students PDF</span></a>
            <a class="btn btn--secondary btn--download dl-xlsx" href="/classes/students-excel" download
               title="Every class and its students as an Excel workbook (.xlsx): one worksheet per class" aria-label="Download Students Excel">@Ui.Icon("sheet")<span><span class="dl-verb">Download </span>Students Excel</span></a>
        </div>
    </div>
</div>

<nav class="hub hub--large" aria-label="Class stages">
    @foreach (var c in Model.Cards)
    {
        <a class="hub-card hub-card--@c.Tone" href="@c.Href">
            <span class="hub-card__icon" aria-hidden="true">@Ui.Icon(c.Icon)</span>
            <span class="hub-card__body">
                <span class="hub-card__title">@c.Title</span>
                <span class="hub-card__text">@c.Description</span>
                @if (c.Meta is not null)
                {
                    <span class="hub-card__meta">@c.Meta</span>
                }
            </span>
            <span class="hub-card__go" aria-hidden="true">@Ui.Icon("arrow-right")</span>
        </a>
    }
</nav>

@if (Model.Extra.Count > 0)
{
    <div class="hub-extra">
        @foreach (var (label, href, icon) in Model.Extra)
        {
            <a class="chip" href="@href">@Ui.Icon(icon)@label</a>
        }
    </div>
}
