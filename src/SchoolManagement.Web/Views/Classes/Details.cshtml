@model ClassDetailsViewModel
@*
    Class page (/classes/{id}). Default: the class's students, like a regular class page. KG Stage classes (Pre-K, KG1,
    KG2) add a compact teaching-team summary and a Teaching Team button that opens the team panel (?panel=team); the
    Homeroom Teacher and Co-Teacher dropdowns (one each, the same control) appear only after Edit Teaching Team (&edit=1).
    Other stages have no team.
    The team is class-level information only: it does not change timetable sessions, P.E. staff or workload.
*@
@using SchoolManagement.Web.Controllers
@using SchoolManagement.Web.Entities
@{
    var c = Model.Class;
    var team = Model.Team;
    var inTeam = Model.Panel != ClassPanel.Students;
    var editing = Model.Panel == ClassPanel.TeamEdit && team is not null;
    ViewData["Title"] = inTeam ? $"{c.Name} · Teaching Team" : c.Name;
    ViewData["Nav"] = "Classes";
    var crumbs = new List<(string Label, string? Href)> { ("Dashboard", "/"), ("Classes", "/classes") };
    if (Model.StageTitle is not null) crumbs.Add((Model.StageTitle, Model.StageHref));
    var dateFmt = System.Globalization.CultureInfo.InvariantCulture;
    var teamHref = ClassesController.TeamHref(c.Id, team?.Year.Id);
}

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs">
            @foreach (var (label, href) in crumbs) { <li><a href="@href">@label</a></li> }
            @if (inTeam)
            {
                <li><a href="/classes/@c.Id" dir="auto">@c.Name</a></li>
                <li><span aria-current="page">Teaching Team</span></li>
            }
            else
            {
                <li><span aria-current="page" dir="auto">@c.Name</span></li>
            }
        </ol>
        <h1 class="page-title" dir="auto">@c.Name</h1>
        <p class="page-sub">
            @(Model.GroupTitle ?? "Outside the four stages")
            · @c.StudentCount / @c.Capacity students @ClassCapacity.Badge(c.StudentCount, c.Capacity)
            · @if (c.IsActive) { <span class="badge badge--success badge--dot">Active</span> } else { <span class="badge badge--neutral badge--dot">Inactive</span> }
        </p>
    </div>
    <div class="page-head__actions">
        @if (Model.IsKg)
        {
            if (inTeam)
            {
                <a class="btn btn--secondary" href="/classes/@c.Id">@Ui.Icon("arrow-left")Back to students</a>
            }
            else
            {
                <a class="btn btn--primary" href="@teamHref">@Ui.Icon("users")Teaching Team</a>
            }
        }
        <a class="btn btn--secondary" href="/students?classId=@c.Id">@Ui.Icon("users")View students</a>
        <a class="btn btn--ghost" href="/classes/edit/@c.Id" data-modal>@Ui.Icon("pencil")Edit</a>
    </div>
</div>

@if (!inTeam)
{
    @* ---------------- KG: compact team summary (read-only) ---------------- *@
    @if (Model.IsKg)
    {
        <a class="team-summary" href="@teamHref" aria-label="Open the teaching team of @c.Name">
            <span class="team-summary__label">@Ui.Icon("users")Teaching Team@(team is null ? "" : $" · {team.Year.Name}")</span>
            @if (team is null)
            {
                <span class="muted">No academic year yet</span>
            }
            else
            {
                <span class="team-summary__item">
                    <span class="faint">Homeroom</span>
                    @if (team.Homeroom is { } hr)
                    {
                        <span class="team-mini"><span class="avatar avatar--@Ui.Tone(hr.Name)" aria-hidden="true">@Ui.Initials(hr.Name)</span><span dir="auto">@hr.Name</span></span>
                    }
                    else
                    {
                        <span class="muted">Not assigned</span>
                    }
                </span>
                <span class="team-summary__item">
                    <span class="faint">Co-Teacher</span>
                    @if (team.CoTeacher is { } co)
                    {
                        <span class="team-mini"><span class="avatar avatar--@Ui.Tone(co.Name)" aria-hidden="true">@Ui.Initials(co.Name)</span><span dir="auto">@co.Name</span></span>
                        @if (team.HasExtraCoTeachers) { <span class="badge badge--warning" title="More than one active Co-Teacher from before: choose one">+@(team.CoTeachers.Count - 1)</span> }
                    }
                    else
                    {
                        <span class="muted">Not assigned</span>
                    }
                </span>
            }
            <span class="team-summary__go" aria-hidden="true">@Ui.Icon("arrow-right")</span>
        </a>
    }

    @* ---------------- students (default view) ---------------- *@
    <section class="card" aria-labelledby="students-title">
        <div class="card__head">
            <h2 class="card__title" id="students-title">@Ui.Icon("graduation-cap")Students</h2>
            <a class="btn btn--secondary btn--sm" href="/classes/@c.Id/students/create" data-modal>@Ui.Icon("user-plus", "icon--sm")Add student</a>
        </div>
        <div id="class-students" data-ajax-list aria-live="polite">
            <partial name="~/Views/Students/_Table.cshtml" model="Model.Students" />
        </div>
    </section>
}
else if (team is null)
{
    <section class="card class-team">
        <div class="card__head"><h2 class="card__title">@Ui.Icon("users")@c.Name — Class Teaching Team</h2></div>
        <div class="empty">
            <span class="empty__icon">@Ui.Icon("calendar")</span>
            <p class="empty__title">No academic year yet</p>
            <p class="empty__text">Teaching teams are kept per academic year. Add one under School Calendar (sidebar → Academics), then assign this class's team.</p>
        </div>
    </section>
}
else
{
    @* ---------------- KG: teaching team panel ---------------- *@
    <section class="card class-team" id="team" aria-labelledby="team-title">
        <div class="card__head">
            <div>
                <h2 class="card__title" id="team-title">@Ui.Icon("users")@c.Name — Class Teaching Team</h2>
                <p class="card__sub">Academic year <strong>@team.Year.Name</strong>@(team.Year.IsCurrent ? " (current)" : ""). Each year has its own team; earlier years are kept.</p>
            </div>
            <div class="class-team__tools">
                @if (Model.Years.Count > 1)
                {
                    <form method="get" action="/classes/@c.Id" class="class-team__year">
                        <input type="hidden" name="panel" value="team" />
                        <label class="visually-hidden" for="team-year">Academic year</label>
                        <select class="select" id="team-year" name="year" data-autosubmit>
                            @foreach (var y in Model.Years)
                            {
                                <option value="@y.Id" selected="@(y.Id == team.Year.Id)">@y.Name@(y.IsCurrent ? " (current)" : "")</option>
                            }
                        </select>
                    </form>
                }
                @if (!editing)
                {
                    <a class="btn btn--primary btn--sm" href="@ClassesController.TeamHref(c.Id, team.Year.Id, edit: true)">@Ui.Icon("pencil", "icon--sm")Edit Teaching Team</a>
                }
            </div>
        </div>

        @if (team.HasExtraCoTeachers)
        {
            <div class="notice notice--warning class-team__notice">@Ui.Icon("alert-triangle")<div class="notice__body"><strong>This class has @team.CoTeachers.Count active Co-Teachers from before the one-Co-Teacher rule: @string.Join(", ", team.CoTeachers.Select(m => m.Name)).</strong>Nothing was changed automatically. Edit the teaching team and choose the one Co-Teacher who stays; the others are then ended and kept in the history.</div></div>
        }
        @if (!editing)
        {
            <div class="class-team__grid card__body">
                <div class="class-team__area">
                    <h3 class="class-team__label">Homeroom Teacher</h3>
                    @if (team.Homeroom is { } h)
                    {
                        <ul class="team-chips"><li>@await Html.PartialAsync("_TeamChip", (h, team.Year.Id, c.Id))</li></ul>
                    }
                    else
                    {
                        <p class="muted class-team__empty">No Homeroom Teacher assigned.</p>
                    }
                </div>
                <div class="class-team__area">
                    <h3 class="class-team__label">Co-Teacher</h3>
                    @if (team.CoTeachers.Count == 0)
                    {
                        <p class="muted class-team__empty">No Co-Teacher assigned.</p>
                    }
                    else
                    {
                        <ul class="team-chips">
                            @foreach (var m in team.CoTeachers) { <li>@await Html.PartialAsync("_TeamChip", (m, team.Year.Id, c.Id))</li> }
                        </ul>
                    }
                </div>
            </div>
        }
        else
        {
            <form method="post" action="/classes/@c.Id/team" class="card__body class-team__form" data-loading autocomplete="off" data-class-team>
                @Html.AntiForgeryToken()
                <input type="hidden" name="yearId" value="@team.Year.Id" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="class-team__grid">
                    <div class="field">
                        <label class="label" for="HomeroomId">Homeroom Teacher <span class="faint" style="font-weight:600">(one)</span></label>
                        <select class="select" id="HomeroomId" name="HomeroomId" data-searchable data-team-homeroom>
                            <option value="">No Homeroom Teacher</option>
                            @foreach (var s in Model.Staff)
                            {
                                <option value="@s.Id" selected="@(Model.HomeroomId == s.Id)">@s.FullName@(s.JobTitle is null ? "" : $" — {s.JobTitle}")</option>
                            }
                        </select>
                        @if (team.Homeroom is { } current)
                        {
                            <p class="hint">Choosing someone else and saving replaces @current.Name; the previous assignment is kept in the history.</p>
                        }
                        <span asp-validation-for="HomeroomId" class="field-validation-error"></span>
                    </div>
                    <div class="field">
                        <label class="label" for="CoTeacherId">Co-Teacher <span class="faint" style="font-weight:600">(one)</span></label>
                        <select class="select" id="CoTeacherId" name="CoTeacherId" data-searchable data-team-co>
                            <option value="">No Co-Teacher</option>
                            @foreach (var s in Model.Staff)
                            {
                                <option value="@s.Id" selected="@(Model.CoTeacherId == s.Id)">@s.FullName@(s.JobTitle is null ? "" : $" — {s.JobTitle}")</option>
                            }
                        </select>
                        @if (team.HasExtraCoTeachers)
                        {
                            <p class="hint">Saving keeps only the Co-Teacher chosen here; @(team.CoTeachers.Count - 1) other active Co-Teacher@(team.CoTeachers.Count == 2 ? " is" : "s are") ended and kept in the history.</p>
                        }
                        else if (team.CoTeacher is { } currentCo)
                        {
                            <p class="hint">Choosing someone else and saving replaces @currentCo.Name; the previous assignment is kept in the history.</p>
                        }
                        <span asp-validation-for="CoTeacherId" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="class-team__foot">
                    <button class="btn btn--primary" type="submit">@Ui.Icon("check")Save Changes</button>
                    <a class="btn btn--secondary" href="@ClassesController.TeamHref(c.Id, team.Year.Id)">Cancel</a>
                    <span class="faint">Changes only this class's team for @team.Year.Name. Timetable, P.E. and workload are not affected.</span>
                </div>
            </form>
        }

        @if (team.Ended.Count > 0)
        {
            <details class="card__body class-team__past">
                <summary>Previous assignments in @team.Year.Name (@team.Ended.Count)</summary>
                <div class="table-wrap">
                    <table class="table table--stack">
                        <thead><tr><th scope="col">Staff</th><th scope="col">Role</th><th scope="col">Assigned</th><th scope="col">Ended</th><th scope="col">Reason</th></tr></thead>
                        <tbody>
                            @foreach (var e in team.Ended)
                            {
                                <tr>
                                    <td data-label="Staff" dir="auto">@e.Name</td>
                                    <td data-label="Role">@ClassTeachingRoles.Label(e.Role)</td>
                                    <td data-label="Assigned" class="num">@SchoolTime.Current.ToLocal(e.AssignedAt).ToString("d MMM yyyy", dateFmt)</td>
                                    <td data-label="Ended" class="num">@(e.EndedAt is { } ended ? SchoolTime.Current.ToLocal(ended).ToString("d MMM yyyy", dateFmt) : "—")</td>
                                    <td data-label="Reason" dir="auto">@(e.EndReason ?? "—")@(e.EndedBy is null ? "" : $" · {e.EndedBy}")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }

        <details class="card__body class-team__past">
            <summary>Teaching team history (@team.History.Count@(team.History.Count == 100 ? "+" : ""))</summary>
            @if (team.History.Count == 0)
            {
                <p class="muted class-team__empty">No changes recorded yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table--stack">
                        <thead><tr><th scope="col">When</th><th scope="col">Year</th><th scope="col">Staff</th><th scope="col">Change</th><th scope="col">Role</th><th scope="col">By</th></tr></thead>
                        <tbody>
                            @foreach (var ev in team.History)
                            {
                                <tr>
                                    <td data-label="When" class="num">@SchoolTime.Current.ToLocal(ev.At).ToString("d MMM yyyy HH:mm", dateFmt)</td>
                                    <td data-label="Year">@ev.Year</td>
                                    <td data-label="Staff" dir="auto">@ev.StaffName</td>
                                    <td data-label="Change">@ClassTeachingRoles.Label(ev.Operation)@(ev.Details is null ? "" : $" — {ev.Details}")</td>
                                    <td data-label="Role">@(ev.PreviousRole is { } pr ? ClassTeachingRoles.Label(pr) : "—") → @(ev.NewRole is { } nr ? ClassTeachingRoles.Label(nr) : "—")</td>
                                    <td data-label="By" dir="auto">@(ev.By ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </details>
    </section>
}

@section Scripts {
    @if (editing)
    {
    <script>
        // Frontend copy of the rule the server enforces: one staff member cannot be Homeroom Teacher and Co-Teacher of the
        // same class. Both dropdowns behave the same: choosing someone already in the other role clears that role.
        (function () {
            var form = document.querySelector("[data-class-team]");
            if (!form) return;
            var homeroom = form.querySelector("[data-team-homeroom]");
            var co = form.querySelector("[data-team-co]");
            function guard(changed, other, otherRole) {
                if (!changed.value || changed.value !== other.value) return;
                other.value = "";
                other.dispatchEvent(new Event("change", { bubbles: true }));
                if (window.App && App.toast) App.toast("One staff member cannot hold both roles: " + otherRole + " cleared.", "info");
            }
            homeroom.addEventListener("change", function () { guard(homeroom, co, "Co-Teacher"); });
            co.addEventListener("change", function () { guard(co, homeroom, "Homeroom Teacher"); });
        })();
    </script>
    }
}
