@model TaskIndexViewModel
@*
    Filters for a task list (Tasks page or a member profile), as labelled fields in a wrapping grid.
    People / department (Tasks page only) reload the page, so the summary counts follow them; search, status, priority,
    due date and sort reload #task-list in place (app.js).
*@
@{
    var q = Model.Query;
    string? Iso(DateOnly? d) => d is { } x ? SchoolWeek.Iso(x) : null;
}
<div class="task-filters@(Model.IsGlobal ? " task-filters--global" : "")">
    @if (!Model.ForMember)
    {
        <form class="task-filters__group" action="@Model.BaseUrl" method="get" aria-label="Filter by people and department">
            @foreach (var (key, value) in new[] { ("search", q.Search), ("status", q.Status), ("priority", q.Priority), ("due", q.Due), ("mine", q.Mine), ("sort", q.Sort == "due" ? null : q.Sort),
                         ("tab", q.Tab), ("dueFrom", Iso(q.DueFrom)), ("dueTo", Iso(q.DueTo)) })
            {
                if (!string.IsNullOrWhiteSpace(value)) { <input type="hidden" name="@key" value="@value" /> }
            }
            <div class="task-filter">
                <label class="task-filter__label" for="f-assignee">@Ui.Icon("user", "icon--sm")Assigned to</label>
                <select class="select" id="f-assignee" name="memberId" data-searchable data-search-notes data-autosubmit>
                    <option value="">Anyone</option>
                    @foreach (var s in Model.Staff)
                    {
                        <option value="@s.Id" selected="@(q.MemberId == s.Id)" data-note="@s.Note">@s.FullName</option>
                    }
                </select>
            </div>
            <div class="task-filter">
                <label class="task-filter__label" for="f-reviewer">@Ui.Icon("send", "icon--sm")Submitted to</label>
                <select class="select" id="f-reviewer" name="reviewerId" data-searchable data-search-notes data-autosubmit>
                    <option value="">Anyone</option>
                    @foreach (var s in Model.Staff)
                    {
                        <option value="@s.Id" selected="@(q.ReviewerId == s.Id)" data-note="@s.Note">@s.FullName</option>
                    }
                </select>
            </div>
            <div class="task-filter">
                <label class="task-filter__label" for="f-dept">@Ui.Icon("layers", "icon--sm")Department</label>
                <select class="select" id="f-dept" name="department" data-autosubmit>
                    <option value="">All departments</option>
                    <option value="management" selected="@(q.Department == "management")">Management Team</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(q.Department == d.Id.ToString())">@d.Name</option>
                    }
                </select>
            </div>
            @if (Model.IsGlobal)
            {
                <div class="task-filter">
                    <label class="task-filter__label" for="f-category">@Ui.Icon("users", "icon--sm")Staff category</label>
                    <select class="select" id="f-category" name="category" data-autosubmit>
                        <option value="">All staff</option>
                        @foreach (var c in StaffCategories.All)
                        {
                            <option value="@StaffCategories.Slug(c)" selected="@(q.Category == StaffCategories.Slug(c))">@StaffCategories.Name(c)</option>
                        }
                    </select>
                </div>
            }
            <noscript><button class="btn btn--secondary" type="submit">Apply</button></noscript>
        </form>
    }
    <form class="task-filters__group task-filters__group--list" action="@Model.BaseUrl" method="get" role="search" data-list-filter="#task-list">
        @if (!Model.ForMember)
        {
            @foreach (var (key, value) in new[] { ("memberId", q.MemberId?.ToString()), ("reviewerId", q.ReviewerId?.ToString()), ("department", q.Department), ("mine", q.Mine),
                         ("category", q.Category), ("tab", q.Tab) })
            {
                if (!string.IsNullOrWhiteSpace(value)) { <input type="hidden" name="@key" value="@value" /> }
            }
        }
        <div class="task-filter task-filter--search">
            <label class="task-filter__label" for="f-search-@(Model.ForMember ? "m" : "t")">@Ui.Icon("search", "icon--sm")Search</label>
            <div class="input-icon">
                @Ui.Icon("search")
                <input class="input" type="search" id="f-search-@(Model.ForMember ? "m" : "t")" name="search" value="@q.Search" placeholder="Title, description@(Model.ForMember ? "" : " or person")…" autocomplete="off" dir="auto" />
            </div>
        </div>
        <div class="task-filter">
            <label class="task-filter__label" for="f-status">Status</label>
            <select class="select" id="f-status" name="status">
                <option value="">All statuses</option>
                <option value="open" selected="@(q.Status == "open")">Open (not done or cancelled)</option>
                <option value="todo" selected="@(q.Status is "todo" or "pending")">Pending (To Do)</option>
                <option value="in-progress" selected="@(q.Status == "in-progress")">In Progress</option>
                <option value="completed" selected="@(q.Status == "completed")">Completed</option>
                <option value="cancelled" selected="@(q.Status == "cancelled")">Cancelled</option>
                <option value="on-hold" selected="@(q.Status == "on-hold")">On Hold</option>
                <option value="overdue" selected="@(q.Status == "overdue")">Overdue</option>
            </select>
        </div>
        <div class="task-filter">
            <label class="task-filter__label" for="f-priority">Priority</label>
            <select class="select" id="f-priority" name="priority">
                <option value="">All priorities</option>
                @foreach (var p in TaskLabels.Priorities)
                {
                    <option value="@TaskLabels.PrioritySlug(p)" selected="@(TaskLabels.ParsePriority(q.Priority) == p)">@TaskLabels.Priority(p)</option>
                }
            </select>
        </div>
        <div class="task-filter">
            <label class="task-filter__label" for="f-due">Due date</label>
            <select class="select" id="f-due" name="due">
                <option value="">Any due date</option>
                <option value="overdue" selected="@(q.Due == "overdue")">Overdue</option>
                <option value="today" selected="@(q.Due == "today")">Due today</option>
                <option value="week" selected="@(q.Due == "week")">Next 7 days</option>
                <option value="later" selected="@(q.Due == "later")">Due later</option>
                <option value="none" selected="@(q.Due == "none")">No due date</option>
            </select>
        </div>
        @if (Model.IsGlobal)
        {
            <div class="task-filter">
                <label class="task-filter__label" for="f-due-from">Due from</label>
                <input class="input picker" type="date" id="f-due-from" name="dueFrom" value="@Iso(q.DueFrom)" data-empty-text="Any date" />
            </div>
            <div class="task-filter">
                <label class="task-filter__label" for="f-due-to">Due to</label>
                <input class="input picker" type="date" id="f-due-to" name="dueTo" value="@Iso(q.DueTo)" data-empty-text="Any date" />
            </div>
        }
        <div class="task-filter">
            <label class="task-filter__label" for="f-sort">Sort by</label>
            <select class="select" id="f-sort" name="sort">
                <option value="due" selected="@(q.Sort == "due")">Due date</option>
                <option value="priority" selected="@(q.Sort == "priority")">Priority</option>
                <option value="status" selected="@(q.Sort == "status")">Status</option>
                <option value="created" selected="@(q.Sort == "created")">Newest first</option>
                <option value="oldest" selected="@(q.Sort == "oldest")">Oldest first</option>
                <option value="title" selected="@(q.Sort == "title")">Title A–Z</option>
            </select>
        </div>
        <input type="hidden" name="pageSize" value="@q.PageSize" />
        <input type="hidden" name="page" value="" />
        <noscript><button class="btn btn--secondary" type="submit">Apply</button></noscript>
    </form>
</div>
