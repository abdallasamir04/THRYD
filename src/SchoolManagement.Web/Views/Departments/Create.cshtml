@model DepartmentCreateModel
@{
    var modal = Context.Request.IsAjax();
    if (modal) { Layout = null; }
    else { ViewData["Title"] = "Add department"; ViewData["Nav"] = "Departments"; }
}

@if (!modal)
{
    <div class="page-head">
        <div class="page-head__text">
            <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/staff">Staff</a></li><li><a href="/staff/academic">Academic Staff</a></li><li><a href="/staff/departments">Departments</a></li><li>Add department</li></ol>
            <h1 class="page-title">Add department</h1>
        </div>
    </div>
}

<div class="@(modal ? "modal__content" : "card form-page")">
    <form action="/staff/departments/create" method="post" data-ajax-form="@(modal ? "" : null)" data-loading autocomplete="off" style="display:contents">
        @Html.AntiForgeryToken()
        <div class="modal__head">
            <span class="modal__icon">@Ui.Icon("layers", "icon--lg")</span>
            <div>
                <h2 class="modal__title">Add department</h2>
                <p class="modal__sub">A new academic department. You can assign its Head of Department now, or later from its page.</p>
            </div>
            <button class="icon-btn modal__close" type="button" data-modal-close aria-label="Close">@Ui.Icon("x")</button>
        </div>
        <div class="modal__body form-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="field">
                <label class="label" asp-for="Name">Department Name <span class="req" aria-hidden="true">*</span></label>
                <input class="input" asp-for="Name" maxlength="100" dir="auto" placeholder="e.g. Mathematics" required data-autofocus />
                <span asp-validation-for="Name" class="field-validation-error"></span>
                <p class="hint">Must be unique. The name is fixed once the department is created, so reports and imports stay consistent.</p>
            </div>
            @* Academic staff who are not an HOD anywhere (Management Team members never are). The chosen teacher joins this department. *@
            <div class="field">
                <label class="label" for="HeadTeacherId">HOD (Optional)</label>
                <select class="select" id="HeadTeacherId" name="HeadTeacherId" data-searchable data-search-notes>
                    <option value="">No HOD assigned</option>
                    @foreach (var c in Model.Candidates)
                    {
                        <option value="@c.Id" selected="@(Model.HeadTeacherId == c.Id)"
                                data-note="@string.Join(" · ", new[] { c.CurrentDepartment ?? "No department", c.JobTitle }.Where(x => !string.IsNullOrWhiteSpace(x)))">@c.FullName</option>
                    }
                </select>
                <span asp-validation-for="HeadTeacherId" class="field-validation-error"></span>
                <p class="hint">The chosen teacher moves into this department (their subcategory and subject are cleared) and becomes its HOD from today. Staff who already head a department are not listed.</p>
            </div>
        </div>
        <div class="modal__foot">
            @if (modal)
            {
                <button class="btn btn--secondary" type="button" data-modal-close>Cancel</button>
            }
            else
            {
                <a class="btn btn--secondary" href="/staff/departments">Cancel</a>
            }
            <button class="btn btn--primary" type="submit">@Ui.Icon("plus")Add department</button>
        </div>
    </form>
</div>
