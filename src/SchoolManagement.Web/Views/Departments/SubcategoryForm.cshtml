@model SubcategoryFormModel
@{
    var modal = Context.Request.IsAjax();
    var parent = Model.Parents.FirstOrDefault(p => p.Id == Model.ParentId);
    var what = parent is null ? Model.Noun : "subject";
    var heading = Model.IsEdit ? $"Edit {what}" : $"Add {what}";
    if (modal) { Layout = null; }
    else { ViewData["Title"] = heading; ViewData["Nav"] = "Departments"; }
    var action = Model.IsEdit ? $"/staff/departments/subcategories/{Model.Id}/edit" : $"/staff/departments/{Model.DepartmentId}/subcategories/create";
}

@if (!modal)
{
    <div class="page-head">
        <div class="page-head__text">
            <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/staff/departments">Departments</a></li><li><a href="/staff/departments/@Model.DepartmentId/subcategories">@Model.DepartmentName</a></li><li>@heading</li></ol>
            <h1 class="page-title">@heading</h1>
        </div>
    </div>
}

<div class="@(modal ? "modal__content" : "card form-page")">
    <form action="@action" method="post" data-ajax-form="@(modal ? "" : null)" data-loading autocomplete="off" style="display:contents">
        @Html.AntiForgeryToken()
        <div class="modal__head">
            <span class="modal__icon">@Ui.Icon(Model.IsEdit ? "pencil" : "plus", "icon--lg")</span>
            <div>
                <h2 class="modal__title">@heading</h2>
                <p class="modal__sub">@Model.DepartmentName@(parent is null ? "" : " · " + parent.Name)</p>
            </div>
            <button class="icon-btn modal__close" type="button" data-modal-close aria-label="Close">@Ui.Icon("x")</button>
        </div>
        <div class="modal__body form-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            @if (!Model.IsEdit && Model.ParentId is not null)
            {
                <input type="hidden" name="ParentId" value="@Model.ParentId" />
            }
            <div class="field">
                <label class="label" asp-for="Name">Name <span class="req" aria-hidden="true">*</span></label>
                <input class="input" asp-for="Name" dir="auto" maxlength="50" placeholder="@(Model.Noun == "language" && parent is null ? "e.g. Spanish" : "Name")" data-autofocus />
                <span asp-validation-for="Name" class="field-validation-error"></span>
                @if (Model.IsEdit)
                {
                    <p class="hint">Renaming updates every staff record and timetable session that uses this name.</p>
                }
            </div>
            @if (Model.IsEdit)
            {
                <label class="switch">
                    <input type="checkbox" asp-for="IsActive" />
                    <span class="switch__track" aria-hidden="true"></span>
                    <span>Active — offered when adding or editing staff</span>
                </label>
            }
        </div>
        <div class="modal__foot">
            @if (modal)
            {
                <button class="btn btn--secondary" type="button" data-modal-close>Cancel</button>
            }
            else
            {
                <a class="btn btn--secondary" href="/staff/departments/@Model.DepartmentId/subcategories">Cancel</a>
            }
            <button class="btn btn--primary" type="submit">@Ui.Icon("check")@(Model.IsEdit ? "Save changes" : "Add")</button>
        </div>
    </form>
</div>
