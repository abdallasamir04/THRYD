@model SchoolManagement.Web.Services.Timetables.Import.TimetableUploadPage
@using SchoolManagement.Web.Services.Timetables.Import
@*
    Timetables → Upload Timetable, step 1: the academic year, the class and the file. The file is read in memory on the
    next step and never stored; nothing is saved before the administrator reviews the preview and presses Save.
*@
@{
    ViewData["Title"] = "Upload Timetable";
    ViewData["Nav"] = "Timetables";
    var selected = Model.Classes.FirstOrDefault(c => c.Id == Model.ClassId);
}
@section Head {
    <link rel="stylesheet" href="~/css/timetable-import.css" asp-append-version="true" />
}

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs"><li><a href="/">Dashboard</a></li><li><a href="/timetables">Timetables</a></li><li><span aria-current="page">Upload Timetable</span></li></ol>
        <h1 class="page-title">Upload Timetable</h1>
        <p class="page-sub">Upload a class's weekly timetable. THRYD reads the days, periods, times, subjects and teachers; you review and correct them before anything is saved.</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/timetables">@Ui.Icon("arrow-left")Back to Timetables</a>
    </div>
</div>

<partial name="_Steps" model="1" />

@if (Model.Error is not null)
{
    <div class="notice notice--error" role="alert">@Ui.Icon("alert-circle")<div class="notice__body"><strong>The timetable could not be read.</strong>@Model.Error</div></div>
}

<div class="ti-upload">
    <section class="card" aria-labelledby="ti-upload-title">
        <div class="card__head">
            <div>
                <h2 class="card__title" id="ti-upload-title">@Ui.Icon("upload")Class, year and file</h2>
                <p class="card__sub">Excel (.xlsx) or CSV, up to 10 MB.</p>
            </div>
        </div>
        <form class="card__body form-grid" method="post" action="/timetables/upload" enctype="multipart/form-data" data-loading>
            @Html.AntiForgeryToken()
            <div class="ti-upload__pickers">
                <div class="field">
                    <label class="label" for="ti-year">Academic year</label>
                    <select class="select" id="ti-year" name="yearId">
                        @foreach (var y in Model.Years)
                        {
                            <option value="@y.Id" selected="@(y.Id == Model.YearId)">@y.Name@(y.IsCurrent ? " (current)" : "")</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label class="label" for="ti-class">Class <span class="req" aria-hidden="true">*</span></label>
                    <select class="select" id="ti-class" name="classId" required data-searchable>
                        <option value="">Choose the class…</option>
                        @foreach (var c in Model.Classes)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.ClassId)" data-note="@(c.Lessons == 0 ? "No timetable yet" : $"Has a timetable · {c.Lessons} lessons")">@c.Name</option>
                        }
                    </select>
                    @if (selected is { Lessons: > 0 })
                    {
                        <p class="hint">@selected.Name already has a timetable (@Ui.Plural(selected.Lessons, "lesson", "lessons")). You will be asked before it is replaced.</p>
                    }
                </div>
            </div>
            <label class="dropzone" data-dropzone>
                <input type="file" name="file" accept="@TimetableImportService.Accept" required />
                <span class="dropzone__icon">@Ui.Icon("upload-cloud", "icon--xl")</span>
                <span class="dropzone__title">Drop the timetable file here, or click to choose</span>
                <span class="muted">.xlsx or .csv</span>
                <span class="dropzone__file">@Ui.Icon("file-check", "icon--sm")<span data-file-name></span></span>
            </label>
            <div><button class="btn btn--primary btn--lg" type="submit" data-needs-file disabled>@Ui.Icon("arrow-right")Read the timetable</button></div>
        </form>
    </section>

    <aside class="card ti-help" aria-labelledby="ti-help-title">
        <div class="card__head"><h2 class="card__title" id="ti-help-title">@Ui.Icon("info")What the file should look like</h2></div>
        <div class="card__body">
            <p>One weekly timetable per sheet, laid out as a grid:</p>
            <ul>
                <li>The days (<strong>Sunday … Thursday</strong>, or <span dir="rtl">الأحد … الخميس</span>) across the top — or down the side.</li>
                <li>One row per period, with its name and times before the first day: <em>Period 1</em>, <em>08:00 – 08:45</em>.</li>
                <li>In each cell the subject, and the teacher if you have it: <em>Math – Ms Hana</em>, or on two lines.</li>
                <li>Breaks, lunch, assembly and clubs are recognised and kept as breaks / activities, not lessons.</li>
            </ul>
            <p class="hint">PDFs and pictures cannot be read automatically (there is no text recognition in THRYD). Export the timetable from Excel instead. When a workbook has one sheet per class, the sheet named after the class is read.</p>
        </div>
    </aside>
</div>
