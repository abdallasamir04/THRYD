@model DashboardViewModel
@*
    Dashboard: every figure is counted from the database on this request. No sample data.
    Students in inactive classes are a data check in Settings → System, not a dashboard category.
*@
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Nav"] = "Dashboard";
    var d = Model.Data;
    var hour = SchoolTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var shown = d.Distribution.Where(x => x.IsActive || x.Count > 0).ToList();
    var seats = CapacityTotals.Of(shown);
}

@{
    // Hero: greeting, live school time (12-hour, Cairo; ticked by the top-bar clock script) and a compact "today" panel
    // built from the figures this page already loads (no new queries, no invented numbers).
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var nowLocal = SchoolTime.Now;
    var counted = SchoolTime.Current.ToLocal(d.GeneratedAtUtc);
    var heroOps = Model.Operations;
    var heroDay = heroOps is null ? null : SchoolWeek.Iso(heroOps.Date);
}
<section class="hero" aria-labelledby="hero-title">
    <div class="hero__main">
        <p class="hero__eyebrow">@Model.Profile.SchoolName@(string.IsNullOrEmpty(Model.Profile.AcademicYear) ? "" : " · " + Model.Profile.AcademicYear)</p>
        <h1 id="hero-title">@greeting</h1>
        <p class="hero__lead">Students, teachers and classes at a glance.</p>
        @* The Live Data bar and the one hero action share a grid column, so the button is exactly as wide as the bar. *@
        <div class="hero__live">
            <p class="live" title="Figures counted at @counted.ToString("hh:mm tt", inv) (Cairo time)">
                <span class="live__dot" aria-hidden="true"></span><span>Live data</span><span class="live__sep" aria-hidden="true"></span>
                <time data-school-now datetime="@nowLocal.ToString("yyyy-MM-dd'T'HH:mm", inv)">@nowLocal.ToString("d MMM yyyy", inv) · @nowLocal.ToString("hh:mm tt", inv)</time>
            </p>
            <a class="btn btn--light hero__import" href="/import-export/choose" data-modal>@Ui.Icon("upload")Import from Excel</a>
        </div>
    </div>

    <ul class="hero__stats" aria-label="Today at a glance">
        @if (heroOps is not null)
        {
            var a = heroOps.Arrivals;
            <li><a class="hero-stat" href="/arrivals?date=@heroDay">
                <span class="hero-stat__icon" aria-hidden="true">@Ui.Icon("graduation-cap")</span>
                <span class="hero-stat__body">
                    <span class="hero-stat__label">Students Arrived</span>
                    <span class="hero-stat__value">@Ui.Count(a.Attended)<small> / @Ui.Count(a.Students)</small></span>
                    <span class="hero-stat__meta">@a.Late late · @a.Absent absent</span>
                </span>
            </a></li>
        }
        @if (heroOps is not null)
        {
            @* Staff Attendance: arrived (Present + Late) out of the active staff expected today — teachers and management. *@
            var sa = heroOps.Staff;
            <li><a class="hero-stat" href="/staff/attendance">
                <span class="hero-stat__icon" aria-hidden="true">@Ui.Icon("users")</span>
                <span class="hero-stat__body">
                    <span class="hero-stat__label">Staff Arrived</span>
                    @if (sa.IsSchoolDay)
                    {
                        <span class="hero-stat__value">@Ui.Count(sa.Counts.Arrived)<small> / @Ui.Count(sa.Counts.Expected)</small></span>
                        <span class="hero-stat__meta">@sa.Counts.Late late · @sa.Counts.Absent absent · @sa.Counts.NotRecorded not recorded</span>
                    }
                    else
                    {
                        <span class="hero-stat__value">—<small> / @Ui.Count(sa.ActiveStaff)</small></span>
                        <span class="hero-stat__meta">Not a school day</span>
                    }
                </span>
            </a></li>
        }
        @if (heroOps is { Coverage.Count: > 0 })
        {
            @* Fully covered sections ÷ sections per category today (each duty card / activity counts once); none shows 0 / 0. *@
            <li class="hero-cover">
                <span class="hero-cover__head">@Ui.Icon("shield-check")Duties covered today</span>
                <ul class="hero-cover__list">
                    @foreach (var cv in heroOps.Coverage)
                    {
                        <li><a class="hero-cover__item" href="@cv.Href" title="@cv.Summary">
                            <span class="hero-cover__name">@cv.Name</span>
                            <span class="hero-cover__value">@cv.Sections.Covered<small> / @cv.Sections.Total</small></span>
                            <span class="hero-cover__bar" aria-hidden="true"><span style="width:@cv.Percent%"></span></span>
                            <span class="visually-hidden">@cv.Summary</span>
                        </a></li>
                    }
                </ul>
            </li>
        }
    </ul>
</section>

<ul class="kpis kpis--3" aria-label="Totals">
    <li><a class="kpi" href="/students">
        <span class="kpi__icon">@Ui.Icon("graduation-cap")</span>
        <span class="kpi__label">Total students</span>
        <span class="kpi__value">@Ui.Count(d.TotalStudents)</span>
        <span class="kpi__meta">Across @Ui.Plural(d.ActiveClasses, "active class", "active classes")</span>
    </a></li>
    <li><a class="kpi kpi--blue" href="/teachers">
        <span class="kpi__icon">@Ui.Icon("presentation")</span>
        <span class="kpi__label">Total teachers</span>
        <span class="kpi__value">@Ui.Count(d.TotalTeachers)</span>
        <span class="kpi__meta">@(d.TeachersWithoutContact == 0 ? "All have a contact number" : $"{d.TeachersWithoutContact} without a contact number")</span>
    </a></li>
    <li><a class="kpi kpi--teal" href="/classes">
        <span class="kpi__icon">@Ui.Icon("door")</span>
        <span class="kpi__label">Total classes</span>
        <span class="kpi__value">@Ui.Count(d.TotalClasses)</span>
        <span class="kpi__meta">@d.ActiveClasses active · @(d.TotalClasses - d.ActiveClasses) inactive · @d.ClassesWithoutStudents empty</span>
    </a></li>
</ul>

<div class="dash-main">
@if (Model.Operations is { } ops)
{
    var day = SchoolWeek.Iso(ops.Date);
    var a = ops.Arrivals;
    var covered = ops.DutyStatus[SchoolManagement.Web.Entities.DutyStatus.Covered];
    var notCovered = ops.DutyStatus[SchoolManagement.Web.Entities.DutyStatus.NotCovered];
    var st = ops.Staff;
    @* Three rows of three: duties, student attendance (School Attendance) and staff attendance (Staff Attendance). *@
    <div class="ops__head dash-main__head">
        <h2 class="card__title" id="ops-title">@Ui.Icon("activity")Today's operations</h2>
    </div>
    <section class="ops" aria-labelledby="ops-title">
        <p class="ops__group" id="ops-duties">Duty summary</p>
        <ul class="ops__grid ops__grid--3" aria-labelledby="ops-duties">
            <li><div class="ops-tile ops-tile--split">
                <a class="ops-split ops-split--ok" href="/duties/audit?from=@day&to=@day&status=covered"><span class="ops-tile__value num">@covered</span><span class="ops-tile__label"><i aria-hidden="true"></i>Covered</span></a>
                <a class="ops-split ops-split--bad" href="/duties/audit?from=@day&to=@day&status=not-covered"><span class="ops-tile__value num">@notCovered</span><span class="ops-tile__label"><i aria-hidden="true"></i>Not covered</span></a>
            </div></li>
            <li><a class="ops-tile" href="/duties/audit?from=@day&to=@day&status=pending"><span class="ops-tile__value num">@ops.DutyStatus[SchoolManagement.Web.Entities.DutyStatus.Pending]</span><span class="ops-tile__label">Duties pending</span></a></li>
            <li><a class="ops-tile ops-tile--info" href="/duties/audit?from=@day&to=@day&status=in-progress"><span class="ops-tile__value num">@ops.DutyStatus[SchoolManagement.Web.Entities.DutyStatus.InProgress]</span><span class="ops-tile__label">Duties in progress</span></a></li>
        </ul>
        <p class="ops__group" id="ops-students">Student attendance</p>
        <ul class="ops__grid ops__grid--3" aria-labelledby="ops-students">
            <li><a class="ops-tile ops-tile--ok" href="/arrivals?date=@day&classId=all"><span class="ops-tile__value num">@a.Present</span><span class="ops-tile__label">Students present (@(a.OnTimePercent is { } p ? p.ToString("0.#") + "% on time" : "—"))</span></a></li>
            <li><a class="ops-tile ops-tile--bad" href="/arrivals?date=@day&classId=all"><span class="ops-tile__value num">@a.Absent</span><span class="ops-tile__label">Students absent</span></a></li>
            <li><a class="ops-tile ops-tile--warn" href="/arrivals?date=@day&classId=all"><span class="ops-tile__value num">@a.Late</span><span class="ops-tile__label">Students late</span></a></li>
        </ul>
        <p class="ops__group" id="ops-staff">Staff attendance <span>· @Ui.Plural(st.ActiveStaff, "active staff member", "active staff") · @(st.IsSchoolDay ? $"{st.Counts.NotRecorded} not recorded" : "not a school day")</span></p>
        <ul class="ops__grid ops__grid--3" aria-labelledby="ops-staff">
            <li><a class="ops-tile ops-tile--ok" href="/staff/attendance?status=present"><span class="ops-tile__value num">@st.Counts.Present</span><span class="ops-tile__label">Staff present</span></a></li>
            <li><a class="ops-tile ops-tile--bad" href="/staff/attendance?status=absent"><span class="ops-tile__value num">@st.Counts.Absent</span><span class="ops-tile__label">Staff absent</span></a></li>
            <li><a class="ops-tile ops-tile--warn" href="/staff/attendance?status=late"><span class="ops-tile__value num">@st.Counts.Late</span><span class="ops-tile__label">Staff late</span></a></li>
        </ul>
    </section>
}

    <section class="card dash-quick" aria-labelledby="quick-title">
        <div class="card__head"><h2 class="card__title" id="quick-title">@Ui.Icon("sparkles")Quick actions</h2></div>
        <nav class="quick" aria-label="Quick actions">
            <a href="/students/create" data-modal><span class="q-icon">@Ui.Icon("user-plus")</span>Add student</a>
            <a href="/staff/create" data-modal><span class="q-icon">@Ui.Icon("users")</span>Add staff</a>
            <a href="/duties"><span class="q-icon">@Ui.Icon("shield-check")</span>Duties</a>
            <a href="/workload"><span class="q-icon">@Ui.Icon("chart")</span>Teacher workload</a>
            <a href="/import-export"><span class="q-icon">@Ui.Icon("upload")</span>Import Excel</a>
            <a href="/classes"><span class="q-icon">@Ui.Icon("door")</span>Manage classes</a>
        </nav>
    </section>
</div>

    @*
        Students by class: one line chart with a point per class (active classes, plus inactive classes that still have
        students), in the Classes order (Pre-K, KG1A … G10B), against one student-count scale (Services/CapacityScale.cs:
        0–25 in steps of 5, growing when needed). The points are joined by a smooth monotone line (Services/EnrolmentLine.cs:
        no invented peaks or dips) with nothing filled under it; a point over its class's capacity is darker blue. Each class
        also gets a subtle dashed tick at its own capacity, so equal capacities read as one reference line. The ratio
        (enrolled/capacity) sits by the point, the name below. The y-axis stays put while the plot scrolls sideways on narrow
        screens. Each class's column opens its student list; js/dashboard-chart.js shows the details (cap-pt__tip) as a tooltip
        on hover and keyboard focus.
    *@
    <section class="card" aria-labelledby="dist-title">
        <div class="card__head">
            <div>
                <h2 class="card__title" id="dist-title">@Ui.Icon("chart")Students by class</h2>
                <p class="card__sub">Enrolled students in each class against its capacity. Active classes, plus inactive classes that still have students.</p>
            </div>
            <div class="legend cap-legend">
                <span><i class="l-enrolled"></i>Enrolled</span>
                <span><i class="l-over"></i>Over capacity</span>
                <span><i class="l-capacity"></i>Class capacity</span>
            </div>
        </div>
        @if (shown.Count == 0)
        {
            <div class="empty">
                <span class="empty__icon">@Ui.Icon("chart")</span>
                <p class="empty__title">No classes yet</p>
                <p class="empty__text">Add classes, then students, to see each class's capacity here.</p>
                <div class="empty__actions">
                    <a class="btn btn--secondary" href="/classes">@Ui.Icon("door")Manage classes</a>
                </div>
            </div>
        }
        else
        {
            <ul class="cap-totals" aria-label="Capacity totals">
                <li><span class="cap-totals__value num">@seats.Students.ToString("N0", inv)</span><span class="cap-totals__label">Total students</span></li>
                <li><span class="cap-totals__value num">@seats.Capacity.ToString("N0", inv)</span><span class="cap-totals__label">Total capacity</span></li>
                <li class="cap-totals--available"><span class="cap-totals__value num">@seats.Available.ToString("N0", inv)</span><span class="cap-totals__label">Available seats</span></li>
                <li class="cap-totals--over @(seats.Over == 0 ? "is-zero" : "")"><span class="cap-totals__value num">@seats.Over.ToString("N0", inv)</span><span class="cap-totals__label">Over capacity</span></li>
            </ul>
            var (top, step) = CapacityScale.For(shown.Max(x => Math.Max(x.Count, x.Capacity)));
            string F(double v) => v.ToString("0.#####", inv);
            string Pct(double v) => (v * 100).ToString("0.###", inv) + "%";
            var ticks = Enumerable.Range(0, top / step + 1).Select(i => i * step).ToList();
            <div class="cap-chart" data-cap-chart style="--cols:@shown.Count">
                <div class="cap-chart__y" aria-hidden="true">
                    @foreach (var t in ticks)
                    {
                        <span class="num" style="bottom:@Pct(t / (double)top)">@t</span>
                    }
                </div>
                <div class="cap-chart__scroll" tabindex="0" role="region" aria-label="Students by class chart (scrolls sideways)">
                    <div class="cap-chart__inner">
                        <div class="cap-chart__grid" aria-hidden="true">
                            @foreach (var t in ticks)
                            {
                                <span class="cap-chart__line @(t == 0 ? "cap-chart__line--base" : "")" style="bottom:@Pct(t / (double)top)"></span>
                            }
                        </div>
                        @* The line, in chart units (one unit per class across, one per student up), stretched to the plot; the stroke keeps its width. *@
                        <svg class="cap-line" viewBox="0 0 @shown.Count @top" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                            <path class="cap-line__path" d="@EnrolmentLine.Path(shown.Select(x => x.Count).ToList(), top)" />
                        </svg>
                        <ol class="cap-chart__cols">
                            @for (var i = 0; i < shown.Count; i++)
                            {
                                var x = shown[i];
                                var state = x.Over > 0 ? "over" : x.IsFull ? "full" : "open";
                                var label = $"{x.Name}: {x.Count} of {x.Capacity} students, " + (x.Over > 0 ? $"{x.Over} over capacity" : x.IsFull ? "full" : $"{x.Available} {(x.Available == 1 ? "seat" : "seats")} available") + $", {x.Utilization}% of capacity used{(x.IsActive ? "" : ", inactive class")}. Opens the class's students.";
                                var v = x.Count / (double)top;
                                // The ratio goes above the point, or below it at a dip (both neighbours higher) where the line would cross it.
                                var dip = (i == 0 || shown[i - 1].Count > x.Count) && (i == shown.Count - 1 || shown[i + 1].Count > x.Count) && shown.Count > 1 && v >= 0.16;
                                <li class="cap-pt cap-pt--@state @(x.IsActive ? "" : "is-inactive")">
                                    <a class="cap-pt__link" href="/students?classId=@x.ClassId" aria-label="@label" data-cap-point>
                                        <span class="cap-pt__plot" style="--v:@F(v);--c:@F(x.Capacity / (double)top)">
                                            <span class="cap-pt__capacity" data-n="@x.Capacity"></span>
                                            <span class="cap-pt__guide"></span>
                                            <span class="cap-pt__dot" data-n="@x.Count"></span>
                                            <span class="cap-pt__value num @(dip ? "is-below" : "") @(x.Count.ToString(inv).Length + x.Capacity.ToString(inv).Length > 4 ? "is-long" : "")">@x.Count<span class="cap-pt__cap">/@x.Capacity</span></span>
                                        </span>
                                        <span class="cap-pt__name">@x.Name</span>
                                    </a>
                                    <div class="cap-pt__tip" hidden>
                                        <p class="cap-tip__title">@x.Name@(x.IsActive ? "" : " · inactive class")</p>
                                        <dl class="cap-tip__rows">
                                            <div><dt>Enrolled</dt><dd class="num">@x.Count</dd></div>
                                            <div><dt>Capacity</dt><dd class="num">@x.Capacity</dd></div>
                                            <div><dt>Available</dt><dd class="num">@x.Available</dd></div>
                                            <div class="@(x.Over > 0 ? "is-over" : "")"><dt>Over capacity</dt><dd class="num">@x.Over</dd></div>
                                            <div class="cap-tip__usage"><dt>Usage</dt><dd class="num">@x.Utilization%</dd></div>
                                        </dl>
                                    </div>
                                </li>
                            }
                        </ol>
                    </div>
                </div>
            </div>
        }
    </section>

@section Scripts {
    <script src="~/js/dashboard-chart.js" asp-append-version="true"></script>
}
