@model AssignPositionAssignmentFormModel
@{
    var modal = Context.Request.IsAjax();
    var heading = Model.IsEdit ? "Edit Leadership Assignment" : "Assign Leadership Position";
    if (modal) { Layout = null; }
    else { ViewData["Title"] = heading; ViewData["Nav"] = "Management"; }
    var action = Model.IsEdit ? $"/management/assignments/{Model.Id}/edit" : "/management/assignments/create";
}

@if (!modal)
{
    <div class="page-head">
        <div class="page-head__text">
            <ol class="crumbs">
                <li><a href="/">Dashboard</a></li>
                <li><a href="/staff">Staff</a></li>
                <li><a href="/management">Management Team</a></li>
                <li><a href="/management/positions-management">Assignments</a></li>
                <li><span aria-current="page">@heading</span></li>
            </ol>
            <h1 class="page-title">@heading</h1>
        </div>
    </div>
}

<div class="@(modal ? "modal__content" : "card form-page")">
    <form action="@action" method="post" data-ajax-form="@(modal ? "" : null)" data-loading autocomplete="off" style="display:contents">
        @Html.AntiForgeryToken()
        @if (Model.IsEdit)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }
        <div class="modal__head">
            <span class="modal__icon">@Ui.Icon("user-check", "icon--lg")</span>
            <div>
                <h2 class="modal__title">@heading</h2>
                <p class="modal__sub">Assign an employee to a defined leadership position or operational role.</p>
            </div>
            <button class="icon-btn modal__close" type="button" data-modal-close aria-label="Close">@Ui.Icon("x")</button>
        </div>

        <div class="modal__body form-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            @if (Model.IsEdit && !string.IsNullOrEmpty(Model.StaffName))
            {
                <div class="notice notice--info" style="grid-column: 1 / -1">
                    @Ui.Icon("info")
                    <div class="notice__body">
                        <strong>@Model.StaffName</strong> — currently holding <em>@Model.PositionTitle</em>
                    </div>
                </div>
            }

            <div class="field">
                <label class="label" asp-for="PositionId">Leadership Position *</label>
                <select class="select" asp-for="PositionId" required>
                    <option value="">Select Position...</option>
                    @foreach (var p in Model.Positions)
                    {
                        <option value="@p.Id" selected="@(Model.PositionId == p.Id)">@p.Title (@(p.OrgUnitName ?? p.TierName ?? "Position"))</option>
                    }
                </select>
                <span asp-validation-for="PositionId" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="StaffMemberId">Staff Member *</label>
                <select class="select" asp-for="StaffMemberId" required>
                    <option value="">Select Employee...</option>
                    @foreach (var s in Model.StaffMembers)
                    {
                        <option value="@s.Id" selected="@(Model.StaffMemberId == s.Id)">@s.FullName (@(s.ContactNumber ?? s.JobTitle ?? "Staff"))</option>
                    }
                </select>
                <span asp-validation-for="StaffMemberId" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="GradeRange">Assigned Grade Range (Optional)</label>
                <input class="input" asp-for="GradeRange" placeholder="e.g. G1-2, G3-6, G7-12, G2-10" />
                <span asp-validation-for="GradeRange" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="StartDate">Start Date *</label>
                <input class="input" type="date" asp-for="StartDate" required />
                <span asp-validation-for="StartDate" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="EndDate">End Date (Optional)</label>
                <input class="input" type="date" asp-for="EndDate" />
                <span asp-validation-for="EndDate" class="field-validation-error"></span>
            </div>

            <div class="field" style="display:flex; align-items:center; gap:0.5rem; margin-top:1.5rem">
                <input type="checkbox" asp-for="IsPrimary" id="assign-primary" />
                <label for="assign-primary" style="margin:0; font-weight:600">Primary Position for Employee</label>
            </div>

            <div class="field field--full">
                <label class="label" asp-for="Notes">Notes / Confirmation Details</label>
                <input class="input" asp-for="Notes" placeholder="e.g. Position requires confirmation, special responsibilities..." />
                <span asp-validation-for="Notes" class="field-validation-error"></span>
            </div>
        </div>

        <div class="modal__foot">
            <button class="btn btn--secondary" type="button" data-modal-close>Cancel</button>
            <button class="btn btn--primary" type="submit">@(Model.IsEdit ? "Save Assignment" : "Assign Position")</button>
        </div>
    </form>
</div>
