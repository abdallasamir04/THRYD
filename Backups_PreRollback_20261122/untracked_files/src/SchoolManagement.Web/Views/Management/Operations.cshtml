@model OperationsLeadershipViewModel
@{
    ViewData["Title"] = "Operations & Administration";
    ViewData["Nav"] = "Management";
}
<span data-refresh-on-save hidden></span>

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs">
            <li><a href="/">Dashboard</a></li>
            <li><a href="/staff">Staff</a></li>
            <li><a href="/management">Management Team</a></li>
            <li><a href="/management/org-chart">Org Chart</a></li>
            <li><span aria-current="page">Operations &amp; Administration</span></li>
        </ol>
        <h1 class="page-title">Operations, Support &amp; Administrative Tier</h1>
        <p class="page-sub">Level 3 (Parents Care &amp; Counseling), Level 4 (Floor Supervisors), and Level 5 (Campus Operations &amp; Support Services).</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/management/positions/create" data-modal>@Ui.Icon("plus")New Operational Position</a>
        <a class="btn btn--primary" href="/management/assignments/create" data-modal>@Ui.Icon("user-plus")Assign Staff</a>
    </div>
</div>

<partial name="_ManagementNav" />

<ul class="kpis" aria-label="Operational totals">
    <li>
        <div class="kpi kpi--teal">
            <span class="kpi__icon">@Ui.Icon("heart")</span>
            <p class="kpi__label">Parents Care &amp; PR</p>
            <p class="kpi__value">@Model.ParentsCareStaff.Count</p>
            <p class="kpi__meta">Counseling &amp; Family Relations</p>
        </div>
    </li>
    <li>
        <div class="kpi kpi--blue">
            <span class="kpi__icon">@Ui.Icon("eye")</span>
            <p class="kpi__label">Floor Supervisors</p>
            <p class="kpi__value">@Model.FloorSupervisors.Count</p>
            <p class="kpi__meta">Covering Floors 1 through 4</p>
        </div>
    </li>
    <li>
        <div class="kpi kpi--purple">
            <span class="kpi__icon">@Ui.Icon("settings")</span>
            <p class="kpi__label">Operational Services</p>
            <p class="kpi__value">@Model.OperationalAssignments.Count</p>
            <p class="kpi__meta">Across @Model.OperationalUnits.Count Special Units</p>
        </div>
    </li>
    <li>
        <div class="kpi kpi--ok">
            <span class="kpi__icon">@Ui.Icon("users")</span>
            <p class="kpi__label">Total Operations Staff</p>
            <p class="kpi__value">@(Model.ParentsCareStaff.Count + Model.FloorSupervisors.Count + Model.OperationalAssignments.Count)</p>
            <p class="kpi__meta">Active Appointments</p>
        </div>
    </li>
</ul>

@* Level 3: Parents Care, Public Relations & Student Counseling *@
<section class="card table-card" style="margin-top:1.5rem">
    <div class="card__head">
        <div>
            <h2 class="card__title">@Ui.Icon("heart")Level 3: Parents Care, PR &amp; Student Counseling</h2>
            <p class="card__sub">Parent communications, admissions, reception, and student behavioral counseling.</p>
        </div>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Staff Member</th>
                    <th>Role Title</th>
                    <th>Unit</th>
                    <th>Contact Phone</th>
                    <th style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.ParentsCareStaff)
                {
                    <tr>
                        <td>
                            <div style="display:flex; align-items:center; gap:0.5rem">
                                <span class="avatar avatar--xs avatar--@Ui.Tone(p.StaffFullName)">@Ui.Initials(p.StaffFullName)</span>
                                <strong><a href="/staff/@p.StaffMemberId" style="text-decoration:none">@p.StaffFullName</a></strong>
                                @if (!p.IsPrimary)
                                {
                                    <span class="badge badge--neutral" style="font-size:0.7rem">Dual</span>
                                }
                            </div>
                        </td>
                        <td><span class="badge badge--primary">@p.PositionTitle</span></td>
                        <td class="faint">@(p.OrgUnitName ?? "Parents Care")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(p.ContactNumber))
                            {
                                <a class="phone-link" href="tel:@p.ContactNumber.Replace(" ", "")" dir="ltr">@Ui.Icon("phone")@p.ContactNumber</a>
                            }
                            else
                            {
                                <span class="faint">—</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <a class="btn btn--xs btn--secondary" href="/management/assignments/@p.Id/edit" data-modal title="Edit Assignment">@Ui.Icon("pencil")Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@* Level 4: Floor Supervisors *@
<section class="card table-card" style="margin-top:2rem">
    <div class="card__head">
        <div>
            <h2 class="card__title">@Ui.Icon("eye")Level 4: Floor Supervisors &amp; Corridor Safety</h2>
            <p class="card__sub">Dedicated floor oversight covering student discipline, movement monitoring, and corridor safety.</p>
        </div>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Supervisor</th>
                    <th>Assignment Title</th>
                    <th>Floor / Area</th>
                    <th>Contact Phone</th>
                    <th style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fs in Model.FloorSupervisors)
                {
                    <tr>
                        <td>
                            <div style="display:flex; align-items:center; gap:0.5rem">
                                <span class="avatar avatar--xs avatar--@Ui.Tone(fs.StaffFullName)">@Ui.Initials(fs.StaffFullName)</span>
                                <strong><a href="/staff/@fs.StaffMemberId" style="text-decoration:none">@fs.StaffFullName</a></strong>
                            </div>
                        </td>
                        <td><span class="badge badge--secondary">@fs.PositionTitle</span></td>
                        <td><span class="badge badge--primary">@(fs.OrgUnitName ?? "Campus Floor")</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(fs.ContactNumber))
                            {
                                <a class="phone-link" href="tel:@fs.ContactNumber.Replace(" ", "")" dir="ltr">@Ui.Icon("phone")@fs.ContactNumber</a>
                            }
                            else
                            {
                                <span class="faint">—</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <a class="btn btn--xs btn--secondary" href="/management/assignments/@fs.Id/edit" data-modal title="Edit Assignment">@Ui.Icon("pencil")Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@* Level 5: Administrative & Operational Tier *@
<section class="card table-card" style="margin-top:2rem">
    <div class="card__head">
        <div>
            <h2 class="card__title">@Ui.Icon("settings")Level 5: Administrative &amp; Operational Services</h2>
            <p class="card__sub">Facilities, logistics, IT, bookstore, storage, copy center, inclusion, and specialized operations.</p>
        </div>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Specialist / Officer</th>
                    <th>Role Title</th>
                    <th>Operational Unit</th>
                    <th>Contact Phone</th>
                    <th>Notes / Alerts</th>
                    <th style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var op in Model.OperationalAssignments)
                {
                    var isWarning = op.RequiresConfirmation;
                    <tr class="@(isWarning ? "row--warning" : "")">
                        <td>
                            <div style="display:flex; align-items:center; gap:0.5rem">
                                <span class="avatar avatar--xs avatar--@Ui.Tone(op.StaffFullName)">@Ui.Initials(op.StaffFullName)</span>
                                <strong><a href="/staff/@op.StaffMemberId" style="text-decoration:none">@op.StaffFullName</a></strong>
                                @if (!op.IsPrimary)
                                {
                                    <span class="badge badge--neutral" style="font-size:0.7rem" title="Additional appointment">Dual</span>
                                }
                            </div>
                        </td>
                        <td>
                            @if (isWarning)
                            {
                                <span class="badge badge--warning">@op.PositionTitle</span>
                            }
                            else
                            {
                                <strong>@op.PositionTitle</strong>
                            }
                        </td>
                        <td><span class="badge badge--neutral">@(op.OrgUnitName ?? "Operations")</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(op.ContactNumber))
                            {
                                <a class="phone-link" href="tel:@op.ContactNumber.Replace(" ", "")" dir="ltr">@Ui.Icon("phone")@op.ContactNumber</a>
                            }
                            else
                            {
                                <span class="faint">—</span>
                            }
                        </td>
                        <td>
                            @if (isWarning)
                            {
                                <span style="color:#d97706; font-size:0.8125rem">@Ui.Icon("alert-triangle", "icon--sm")Needs Confirmation (Row 18)</span>
                            }
                            else if (!string.IsNullOrEmpty(op.Notes))
                            {
                                <span class="faint" style="font-size:0.8125rem">@op.Notes</span>
                            }
                            else
                            {
                                <span class="faint">—</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <a class="btn btn--xs btn--secondary" href="/management/assignments/@op.Id/edit" data-modal title="Edit Assignment">@Ui.Icon("pencil")Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
