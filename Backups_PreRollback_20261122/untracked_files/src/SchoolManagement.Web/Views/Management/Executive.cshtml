@model TierLeadershipViewModel
@{
    ViewData["Title"] = "Executive Management";
    ViewData["Nav"] = "Management";
}
<span data-refresh-on-save hidden></span>

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs">
            <li><a href="/">Dashboard</a></li>
            <li><a href="/staff">Staff</a></li>
            <li><a href="/management">Management Team</a></li>
            <li><a href="/management/org-chart">Org Chart</a></li>
            <li><span aria-current="page">Executive Management</span></li>
        </ol>
        <h1 class="page-title">Executive Management (Level 1)</h1>
        <p class="page-sub">School executive board, directorate, and strategic department heads (Royal Kings 2026/2027).</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/management/positions/create?tierId=@Model.Tier.Id" data-modal>@Ui.Icon("plus")Add Executive Position</a>
        <a class="btn btn--primary" href="/management/assignments/create" data-modal>@Ui.Icon("user-plus")Assign Member</a>
    </div>
</div>

<partial name="_ManagementNav" />

<ul class="kpis" aria-label="Executive leadership totals">
    <li>
        <div class="kpi kpi--blue">
            <span class="kpi__icon">@Ui.Icon("crown")</span>
            <p class="kpi__label">Executive Positions</p>
            <p class="kpi__value">@Model.Positions.Count</p>
            <p class="kpi__meta">Strategic School Governance</p>
        </div>
    </li>
    <li>
        <div class="kpi kpi--ok">
            <span class="kpi__icon">@Ui.Icon("users")</span>
            <p class="kpi__label">Active Executives</p>
            <p class="kpi__value">@Model.Assignments.Count(a => a.IsCurrent)</p>
            <p class="kpi__meta">@Model.Units.Count Directorate Units</p>
        </div>
    </li>
    <li>
        <div class="kpi kpi--teal">
            <span class="kpi__icon">@Ui.Icon("check-circle")</span>
            <p class="kpi__label">Positions Filled</p>
            <p class="kpi__value">@Model.Positions.Count(p => p.CurrentHolders.Count > 0) / @Model.Positions.Count</p>
            <p class="kpi__meta">100% Core Executive Staffed</p>
        </div>
    </li>
</ul>

<section class="card table-card" style="margin-top:1.5rem">
    <div class="card__head">
        <div>
            <h2 class="card__title">@Ui.Icon("shield")Executive Officers &amp; Strategic Leaders</h2>
            <p class="card__sub">Senior leadership members overseeing academic, administrative, and operational domains.</p>
        </div>
    </div>
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Leader</th>
                    <th>Executive Title</th>
                    <th>Unit / Office</th>
                    <th>Contact Phone</th>
                    <th>Start Date</th>
                    <th style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Assignments)
                {
                    <tr>
                        <td>
                            <div style="display:flex; align-items:center; gap:0.75rem">
                                <span class="avatar avatar--sm avatar--@Ui.Tone(a.StaffFullName)">@Ui.Initials(a.StaffFullName)</span>
                                <div>
                                    <strong><a href="/staff/@a.StaffMemberId" style="text-decoration:none">@a.StaffFullName</a></strong>
                                    @if (!a.IsPrimary)
                                    {
                                        <span class="badge badge--neutral" style="margin-left:0.25rem; font-size:0.75rem">Dual Role</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge--primary" style="font-size:0.875rem">@a.PositionTitle</span>
                        </td>
                        <td>
                            <span class="faint">@(a.OrgUnitName ?? "Executive Office")</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(a.ContactNumber))
                            {
                                <a class="phone-link" href="tel:@a.ContactNumber.Replace(" ", "")" dir="ltr">@Ui.Icon("phone")@a.ContactNumber</a>
                            }
                            else
                            {
                                <span class="faint">—</span>
                            }
                        </td>
                        <td class="faint">
                            @a.StartDate.ToString("d MMM yyyy")
                        </td>
                        <td style="text-align:right">
                            <a class="btn btn--xs btn--secondary" href="/management/assignments/@a.Id/edit" data-modal title="Edit Assignment">@Ui.Icon("pencil")Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
