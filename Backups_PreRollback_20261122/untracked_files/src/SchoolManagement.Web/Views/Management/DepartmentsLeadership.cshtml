@model TierLeadershipViewModel
@{
    ViewData["Title"] = "Academic Department Leadership";
    ViewData["Nav"] = "Management";
}
<span data-refresh-on-save hidden></span>

<div class="page-head">
    <div class="page-head__text">
        <ol class="crumbs">
            <li><a href="/">Dashboard</a></li>
            <li><a href="/staff">Staff</a></li>
            <li><a href="/management">Management Team</a></li>
            <li><a href="/management/academic-leadership">Academic Leadership</a></li>
            <li><span aria-current="page">Department Leadership</span></li>
        </ol>
        <h1 class="page-title">Academic Department Leadership (Level 6)</h1>
        <p class="page-sub">Department Heads (HODs), Subject Coordinators, and Stage Team Leaders across all academic disciplines (Royal Kings 2026/2027).</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="/management/positions/create?tierId=@Model.Tier.Id" data-modal>@Ui.Icon("plus")New Department Position</a>
        <a class="btn btn--primary" href="/management/assignments/create" data-modal>@Ui.Icon("user-plus")Assign Leader</a>
    </div>
</div>

<partial name="_ManagementNav" />

<ul class="kpis" aria-label="Department leadership totals">
    <li>
        <div class="kpi kpi--teal">
            <span class="kpi__icon">@Ui.Icon("book-open")</span>
            <p class="kpi__label">Subject Departments</p>
            <p class="kpi__value">@Model.Units.Count</p>
            <p class="kpi__meta">Active Subject Areas</p>
        </div>
    </li>
    <li>
        <div class="kpi kpi--purple">
            <span class="kpi__icon">@Ui.Icon("shield-check")</span>
            <p class="kpi__label">Department HODs</p>
            <p class="kpi__value">@Model.Assignments.Count(a => a.RoleType == LeadershipRoleType.HOD)</p>
            <p class="kpi__meta">Subject Governance</p>
        </div>
    </li>
    <li>
        <div class="kpi kpi--blue">
            <span class="kpi__icon">@Ui.Icon("layers")</span>
            <p class="kpi__label">Stage Coordinators</p>
            <p class="kpi__value">@Model.Assignments.Count(a => a.RoleType == LeadershipRoleType.Coordinator)</p>
            <p class="kpi__meta">Intermediate Bands (G3-6)</p>
        </div>
    </li>
    <li>
        <div class="kpi kpi--ok">
            <span class="kpi__icon">@Ui.Icon("users")</span>
            <p class="kpi__label">Team Leaders</p>
            <p class="kpi__value">@Model.Assignments.Count(a => a.RoleType == LeadershipRoleType.TeamLeader)</p>
            <p class="kpi__meta">Early Grades (G1-2)</p>
        </div>
    </li>
</ul>

@* Grid of Academic Department Cards *@
<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(360px, 1fr)); gap:1.5rem; margin-top:1.5rem">
    @foreach (var unit in Model.Units)
    {
        var unitAssignments = Model.Assignments.Where(a => a.OrgUnitId == unit.Id || a.PositionTitle.Contains(unit.Name, StringComparison.OrdinalIgnoreCase)).ToList();
        var hod = unitAssignments.FirstOrDefault(a => a.RoleType == LeadershipRoleType.HOD);
        var coordinator = unitAssignments.FirstOrDefault(a => a.RoleType == LeadershipRoleType.Coordinator);
        var teamLeader = unitAssignments.FirstOrDefault(a => a.RoleType == LeadershipRoleType.TeamLeader);
        var otherLeaders = unitAssignments.Where(a => a != hod && a != coordinator && a != teamLeader).ToList();

        <article class="card" style="display:flex; flex-direction:column; justify-content:space-between">
            <div>
                <div class="card__head" style="border-bottom:1px solid var(--color-border, #e2e8f0); padding-bottom:0.75rem">
                    <div>
                        <h2 class="card__title" style="font-size:1.125rem">@Ui.Icon("book-open", "icon--sm")@unit.Name Department</h2>
                        <span class="badge badge--neutral" style="font-size:0.75rem">@Ui.Plural(unitAssignments.Count, "leader", "leaders")</span>
                    </div>
                    <a class="btn btn--xs btn--secondary" href="/management/assignments/create" data-modal title="Add Leader to @unit.Name">
                        @Ui.Icon("plus")Add
                    </a>
                </div>

                <div class="card__body" style="padding:1rem">
                    <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.875rem">
                        @* HOD Row *@
                        <li style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem">
                            <div>
                                <span class="badge badge--warning" style="font-size:0.75rem">HOD</span>
                                @if (hod != null)
                                {
                                    <div style="margin-top:0.25rem">
                                        <strong><a href="/staff/@hod.StaffMemberId" style="text-decoration:none">@hod.StaffFullName</a></strong>
                                        @if (!hod.IsPrimary) { <span class="badge badge--neutral" style="font-size:0.7rem">Dual</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(hod.ContactNumber))
                                    {
                                        <a class="phone-link" href="tel:@hod.ContactNumber.Replace(" ", "")" dir="ltr" style="font-size:0.8125rem">
                                            @Ui.Icon("phone", "icon--sm")@hod.ContactNumber
                                        </a>
                                    }
                                }
                                else
                                {
                                    <div class="faint" style="margin-top:0.25rem; font-style:italic">Position vacant</div>
                                }
                            </div>
                            @if (hod != null)
                            {
                                <a class="btn btn--xs btn--ghost" href="/management/assignments/@hod.Id/edit" data-modal title="Edit HOD">@Ui.Icon("pencil")</a>
                            }
                        </li>

                        @* Coordinator Row (if applicable) *@
                        @if (coordinator != null || unit.Name is "English" or "Math" or "Science" or "Arabic")
                        {
                            <li style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem; border-top:1px dashed var(--color-border, #e2e8f0); padding-top:0.625rem">
                                <div>
                                    <div style="display:flex; align-items:center; gap:0.35rem">
                                        <span class="badge badge--primary" style="font-size:0.75rem">Coordinator</span>
                                        <span class="badge badge--secondary" style="font-size:0.7rem">G3-6</span>
                                    </div>
                                    @if (coordinator != null)
                                    {
                                        <div style="margin-top:0.25rem">
                                            <strong><a href="/staff/@coordinator.StaffMemberId" style="text-decoration:none">@coordinator.StaffFullName</a></strong>
                                            @if (!coordinator.IsPrimary) { <span class="badge badge--neutral" style="font-size:0.7rem">Dual</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(coordinator.ContactNumber))
                                        {
                                            <a class="phone-link" href="tel:@coordinator.ContactNumber.Replace(" ", "")" dir="ltr" style="font-size:0.8125rem">
                                                @Ui.Icon("phone", "icon--sm")@coordinator.ContactNumber
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <div class="faint" style="margin-top:0.25rem; font-style:italic">Position vacant</div>
                                    }
                                </div>
                                @if (coordinator != null)
                                {
                                    <a class="btn btn--xs btn--ghost" href="/management/assignments/@coordinator.Id/edit" data-modal title="Edit Coordinator">@Ui.Icon("pencil")</a>
                                }
                            </li>
                        }

                        @* Team Leader Row (if applicable) *@
                        @if (teamLeader != null || unit.Name is "English" or "Math" or "Science" or "Arabic")
                        {
                            <li style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem; border-top:1px dashed var(--color-border, #e2e8f0); padding-top:0.625rem">
                                <div>
                                    <div style="display:flex; align-items:center; gap:0.35rem">
                                        <span class="badge badge--secondary" style="font-size:0.75rem">Team Leader</span>
                                        <span class="badge badge--neutral" style="font-size:0.7rem">G1-2</span>
                                    </div>
                                    @if (teamLeader != null)
                                    {
                                        <div style="margin-top:0.25rem">
                                            <strong><a href="/staff/@teamLeader.StaffMemberId" style="text-decoration:none">@teamLeader.StaffFullName</a></strong>
                                            @if (!teamLeader.IsPrimary) { <span class="badge badge--neutral" style="font-size:0.7rem">Dual</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(teamLeader.ContactNumber))
                                        {
                                            <a class="phone-link" href="tel:@teamLeader.ContactNumber.Replace(" ", "")" dir="ltr" style="font-size:0.8125rem">
                                                @Ui.Icon("phone", "icon--sm")@teamLeader.ContactNumber
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <div class="faint" style="margin-top:0.25rem; font-style:italic">Position vacant</div>
                                    }
                                </div>
                                @if (teamLeader != null)
                                {
                                    <a class="btn btn--xs btn--ghost" href="/management/assignments/@teamLeader.Id/edit" data-modal title="Edit Team Leader">@Ui.Icon("pencil")</a>
                                }
                            </li>
                        }

                        @* Other leaders *@
                        @foreach (var other in otherLeaders)
                        {
                            <li style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem; border-top:1px dashed var(--color-border, #e2e8f0); padding-top:0.625rem">
                                <div>
                                    <div style="display:flex; align-items:center; gap:0.35rem">
                                        <span class="badge badge--neutral" style="font-size:0.75rem">@other.PositionTitle</span>
                                        @if (!string.IsNullOrEmpty(other.GradeRange))
                                        {
                                            <span class="badge badge--secondary" style="font-size:0.7rem">@other.GradeRange</span>
                                        }
                                    </div>
                                    <div style="margin-top:0.25rem">
                                        <strong><a href="/staff/@other.StaffMemberId" style="text-decoration:none">@other.StaffFullName</a></strong>
                                        @if (!other.IsPrimary) { <span class="badge badge--neutral" style="font-size:0.7rem">Dual</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(other.ContactNumber))
                                    {
                                        <a class="phone-link" href="tel:@other.ContactNumber.Replace(" ", "")" dir="ltr" style="font-size:0.8125rem">
                                            @Ui.Icon("phone", "icon--sm")@other.ContactNumber
                                        </a>
                                    }
                                </div>
                                <a class="btn btn--xs btn--ghost" href="/management/assignments/@other.Id/edit" data-modal title="Edit">@Ui.Icon("pencil")</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="card__footer" style="padding:0.75rem 1rem; background:var(--color-bg-subtle, #f8fafc); border-top:1px solid var(--color-border, #e2e8f0); display:flex; justify-content:space-between; align-items:center">
                <span class="faint" style="font-size:0.75rem">Tier 6: Academic</span>
                <a class="btn btn--xs btn--secondary" href="/management/positions-management?unitId=@unit.Id">Positions</a>
            </div>
        </article>
    }
</div>
