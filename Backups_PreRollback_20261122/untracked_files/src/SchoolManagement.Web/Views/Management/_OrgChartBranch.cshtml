@model OrgChartNodeViewModel
@{
    var hasChildren = Model.Children.Count > 0;
    var profileHref = Model.StaffId.HasValue ? $"/staff/{Model.StaffId.Value}" : "#";
    var initials = !string.IsNullOrWhiteSpace(Model.Name) && Model.Name != "Vacant" ? Ui.Initials(Model.Name) : "—";
    var isWarning = Model.RequiresConfirmation;
}

<div class="org-node-wrapper" data-node-id="@Model.Id" style="margin-bottom:1rem">
    <div class="org-node-card @(isWarning ? "org-node-card--warning" : "")">
        <div class="org-node-card__header">
            <span class="avatar avatar--md avatar--@Model.Tone" aria-hidden="true">@initials</span>
            <div style="flex:1; min-width:0">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem">
                    <div>
                        <h4 style="margin:0 0 0.25rem 0; font-size:1rem; font-weight:700">
                            @if (Model.StaffId.HasValue)
                            {
                                <a href="@profileHref" style="text-decoration:none; color:inherit" title="View Profile">@Model.Name</a>
                            }
                            else
                            {
                                <span class="faint">@Model.Name</span>
                            }
                        </h4>
                        <div style="font-size:0.875rem; font-weight:600; color:var(--color-primary-ink, #4338ca)">
                            @Model.Title
                        </div>
                    </div>
                    <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.25rem">
                        @if (isWarning)
                        {
                            <span class="badge badge--warning" title="Job title was unreadable in scanned document">@Ui.Icon("alert-triangle", "icon--sm")Needs Confirmation</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.GradeRange))
                        {
                            <span class="badge badge--secondary" style="font-weight:700">@Model.GradeRange</span>
                        }
                        @if (!Model.IsPrimary)
                        {
                            <span class="badge badge--neutral" title="Additional appointment held by this employee" style="font-size:0.75rem">Dual Role</span>
                        }
                    </div>
                </div>

                <div class="org-node-card__body">
                    <div style="display:flex; flex-wrap:wrap; gap:0.75rem; align-items:center; justify-content:space-between">
                        <div style="display:flex; flex-wrap:wrap; gap:0.5rem; align-items:center">
                            @if (!string.IsNullOrEmpty(Model.UnitName))
                            {
                                <span class="badge badge--neutral" style="font-size:0.75rem">@Ui.Icon("home", "icon--sm")@Model.UnitName</span>
                            }
                            @if (!string.IsNullOrEmpty(Model.TierName))
                            {
                                <span class="faint" style="font-size:0.75rem">@Model.TierName</span>
                            }
                        </div>

                        <div style="display:flex; gap:0.5rem; align-items:center">
                            @if (!string.IsNullOrEmpty(Model.ContactNumber))
                            {
                                <a class="phone-pill" href="tel:@Model.ContactNumber.Replace(" ", "")" dir="ltr" title="Call @Model.Name">
                                    @Ui.Icon("phone", "icon--sm")@Model.ContactNumber
                                </a>
                            }
                            @if (Model.PositionId.HasValue)
                            {
                                <a class="btn btn--xs btn--ghost" href="/management/positions/@Model.PositionId.Value/edit" data-modal title="Edit Position">
                                    @Ui.Icon("pencil", "icon--sm")
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (hasChildren)
    {
        <div class="org-children-grid">
            @foreach (var child in Model.Children)
            {
                @await Html.PartialAsync("_OrgChartBranch", child)
            }
        </div>
    }
</div>
