@model StaffPositionFormModel
@{
    var modal = Context.Request.IsAjax();
    var heading = Model.IsEdit ? "Edit Position" : "Create Leadership Position";
    if (modal) { Layout = null; }
    else { ViewData["Title"] = heading; ViewData["Nav"] = "Management"; }
    var action = Model.IsEdit ? $"/management/positions/{Model.Id}/edit" : "/management/positions/create";
}

@if (!modal)
{
    <div class="page-head">
        <div class="page-head__text">
            <ol class="crumbs">
                <li><a href="/">Dashboard</a></li>
                <li><a href="/staff">Staff</a></li>
                <li><a href="/management">Management Team</a></li>
                <li><a href="/management/positions-management">Positions</a></li>
                <li><span aria-current="page">@heading</span></li>
            </ol>
            <h1 class="page-title">@heading</h1>
        </div>
    </div>
}

<div class="@(modal ? "modal__content" : "card form-page")">
    <form action="@action" method="post" data-ajax-form="@(modal ? "" : null)" data-loading autocomplete="off" style="display:contents">
        @Html.AntiForgeryToken()
        @if (Model.IsEdit)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }
        <div class="modal__head">
            <span class="modal__icon">@Ui.Icon("briefcase", "icon--lg")</span>
            <div>
                <h2 class="modal__title">@heading</h2>
                <p class="modal__sub">Define administrative, operational, or academic leadership position details.</p>
            </div>
            <button class="icon-btn modal__close" type="button" data-modal-close aria-label="Close">@Ui.Icon("x")</button>
        </div>

        <div class="modal__body form-grid">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="field field--full">
                <label class="label" asp-for="Title">Position Title *</label>
                <input class="input" asp-for="Title" placeholder="e.g. Head of English, Floor Supervisor, IT Manager" required />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="TierId">Organizational Tier *</label>
                <select class="select" asp-for="TierId" required>
                    <option value="">Select Tier...</option>
                    @foreach (var t in Model.Tiers)
                    {
                        <option value="@t.Id" selected="@(Model.TierId == t.Id)">Level @t.TierLevel: @t.Name</option>
                    }
                </select>
                <span asp-validation-for="TierId" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="OrgUnitId">Department / Unit</label>
                <select class="select" asp-for="OrgUnitId">
                    <option value="">School-wide (No specific unit)</option>
                    @foreach (var u in Model.Units)
                    {
                        <option value="@u.Id" selected="@(Model.OrgUnitId == u.Id)">@u.Name (@(u.TierName ?? "Unit"))</option>
                    }
                </select>
                <span asp-validation-for="OrgUnitId" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="RoleType">Leadership Role Type</label>
                <select class="select" asp-for="RoleType" asp-items="Html.GetEnumSelectList<LeadershipRoleType>()"></select>
                <span asp-validation-for="RoleType" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="DefaultGradeRange">Grade Range (if applicable)</label>
                <input class="input" asp-for="DefaultGradeRange" placeholder="e.g. G1-2, G3-6, G7-12, G2-10" />
                <span asp-validation-for="DefaultGradeRange" class="field-validation-error"></span>
            </div>

            <div class="field field--full">
                <label class="label" asp-for="Description">Description / Responsibilities</label>
                <textarea class="input" asp-for="Description" rows="2" placeholder="Key responsibilities and mandate..."></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div class="field">
                <label class="label" asp-for="SortOrder">Display Sort Order</label>
                <input class="input" type="number" asp-for="SortOrder" />
                <span asp-validation-for="SortOrder" class="field-validation-error"></span>
            </div>

            <div class="field" style="display:flex; align-items:center; gap:0.5rem; margin-top:1.5rem">
                <input type="checkbox" asp-for="IsActive" id="pos-active" />
                <label for="pos-active" style="margin:0; font-weight:600">Active Position</label>
            </div>
        </div>

        <div class="modal__foot">
            <button class="btn btn--secondary" type="button" data-modal-close>Cancel</button>
            <button class="btn btn--primary" type="submit">@(Model.IsEdit ? "Save Changes" : "Create Position")</button>
        </div>
    </form>
</div>
